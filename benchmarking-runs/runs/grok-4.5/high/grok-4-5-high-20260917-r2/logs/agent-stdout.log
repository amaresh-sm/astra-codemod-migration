    path.join(root, 'bin', 'jscodeshift-rs'),
    path.join(root, 'bin', 'jscodeshift-native'),
    path.join(root, 'target', 'release', 'jscodeshift'),
    path.join(root, 'target', 'debug', 'jscodeshift'),
    path.join(root, 'rust', 'target', 'release', 'jscodeshift'),
    path.join(root, 'rust', 'target', 'debug', 'jscodeshift'),
