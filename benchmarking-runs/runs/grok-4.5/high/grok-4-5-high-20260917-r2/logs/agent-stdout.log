+562|pub fn exit_with_parse_error(e: ParseError) -> ! {
+563|    if e.exit_code != 0 {
+564|        eprint!("{}", e.message);
+565|        if !e.message.ends_with('\n') {
+566|            // original writes e.message as-is
+567|        }
+568|    } else {
+569|        print!("{}", e.message);
+570|    }
+571|    process::exit(e.exit_code);
+572|}
