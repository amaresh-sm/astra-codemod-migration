+576|pub fn default_extensions() -> String {
+577|    // Matches @babel/core DEFAULT_EXTENSIONS + ts,tsx, strip dots, sort, 
join
+578|    let mut exts = vec![
+579|        "js", "jsx", "es6", "es", "mjs", "cjs", "ts", "tsx",
+580|    ];
+581|    exts.sort();
+582|    exts.join(",")
+583|}
