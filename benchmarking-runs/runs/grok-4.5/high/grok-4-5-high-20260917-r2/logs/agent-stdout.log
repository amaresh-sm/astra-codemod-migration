    //! Ignore pattern handling ported from `src/ignoreFiles.js`.
    
    use globset::{Glob, GlobSet, GlobSetBuilder};
    use once_cell::sync::Lazy;
    use regex::Regex;
    use std::path::{Path, PathBuf};
    use std::sync::Mutex;
    
    static MATCHERS: Lazy<Mutex<Vec<String>>> = Lazy::new(|| 
Mutex::new(Vec::new()));
    
    fn add_ignore_pattern(val: &str) {
        if val.is_empty() || val.starts_with('#') {
            return;
        }
        let pattern = val.to_string();
        let mut matchers = MATCHERS.lock().unwrap();
        if !pattern.contains('/') {
            matchers.push(format!("**/{}", pattern));
        } else if pattern.ends_with('/') {
            matchers.push(format!("**/{}**", pattern));
            matchers.push(format!("{}**", pattern));
        }
        matchers.push(pattern);
    }
    
    pub fn add_from_input(input: &[String]) {
        for p in input {
            add_ignore_pattern(p);
        }
    }
    
    pub fn add_from_file(input: &[String]) {
        for config in input {
            let path = Path::new(config);
            if path.is_file() {
                if let Ok(content) = std::fs::read_to_string(path) {
                    for line in content.split('\n') {
                        // also handle \r
                        let line = line.trim_end_matches('\r');
                        add_ignore_pattern(line);
                    }
                }
            }
        }
    }
    
    fn build_globset(patterns: &[String]) -> Option<GlobSet> {
        if patterns.is_empty() {
            return None;
        }
        let mut builder = GlobSetBuilder::new();
        for p in patterns {
            // picomatch with dot:true - try to approximate
            if let Ok(glob) = Glob::new(p) {
                builder.add(glob);
            } else {
                // fallback: escape nothing, try as-is with ** prefix variants 
already added
            }
        }
        builder.build().ok()
    }
    
    /// Match path against ignore patterns (picomatch-compatible approximation).
    pub fn should_ignore(path: &str) -> bool {
        let matchers = MATCHERS.lock().unwrap();
        if matchers.is_empty() {
            return false;
        }
        let patterns: Vec<String> = matchers.clone();
        drop(matchers);
    
        // Strip leading ../ or ./ traversal prefixes for secondary match
        static TRAVERSAL: Lazy<Regex> =
            Lazy::new(|| Regex::new(r"^(?:\.\.?[/\\])+").unwrap());
        let normalized = TRAVERSAL.replace(path, "").to_string();
    
        if match_path(path, &patterns) {
            return true;
        }
        if normalized != path && match_path(&normalized, &patterns) {
            return true;
        }
        false
    }
    
    fn match_path(path: &str, patterns: &[String]) -> bool {
        // Use globset with dot files enabled - GlobSet matches basenames etc.
        // picomatch isMatch with {dot: true}
        // Also try matching with forward slashes normalized
        let normalized = path.replace('\\', "/");
    
        if let Some(set) = build_globset(patterns) {
            if set.is_match(&normalized) || set.is_match(path) {
                return true;
            }
        }
    
        // Additional picomatch-like checks for common patterns
        for pattern in patterns {
            if picomatch_like(&normalized, pattern) {
                return true;
            }
        }
        false
    }
    
    /// Lightweight picomatch-like matcher for gitignore-style globs.
    fn picomatch_like(path: &str, pattern: &str) -> bool {
        // Convert glob to regex roughly like picomatch
        let mut regex = String::from("^");
        let chars: Vec<char> = pattern.chars().collect();
        let mut i = 0;
        while i < chars.len() {
            match chars[i] {
                '*' => {
                    if i + 1 < chars.len() && chars[i + 1] == '*' {
                        // **
                        if i + 2 < chars.len() && chars[i + 2] == '/' {
                            regex.push_str("(?:.*/)?");
                            i += 3;
                            continue;
                        }
                        regex.push_str(".*");
                        i += 2;
                        continue;
                    }
                    regex.push_str("[^/]*");
                }
                '?' => regex.push_str("[^/]"),
                '.' => regex.push_str("\\."),
                '+' | '(' | ')' | '|' | '^' | '$' | '{' | '}' | '[' | ']' | '\\'
=> {
                    regex.push('\\');
                    regex.push(chars[i]);
                }
                c => regex.push(c),
            }
            i += 1;
        }
        regex.push('$');
        if let Ok(re) = Regex::new(&regex) {
            return re.is_match(path);
        }
        false
    }
    
    pub fn reset() {
        MATCHERS.lock().unwrap().clear();
    }
    
    pub fn add_gitignore_cwd() {
        let git_ignore_path: PathBuf = std::env::current_dir()
            .unwrap_or_else(|_| PathBuf::from("."))
            .join(".gitignore");
        if git_ignore_path.is_file() {
            add_from_file(&[git_ignore_path.to_string_lossy().to_string()]);
        }
    }
    

