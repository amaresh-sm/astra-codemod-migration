    use args::{build_cli_options, get_bool, get_string, ParseError};
    use serde_json::Value;
    use std::io::{self, Read};
    use std::path::PathBuf;
    use std::process;
    
    fn package_root() -> PathBuf {
        if let Ok(exe) = std::env::current_exe() {
            let mut dir = exe.parent().map(|p| p.to_path_buf());
            for _ in 0..8 {
                if let Some(ref d) = dir {
                    let pkg = d.join("package.json");
                    if pkg.is_file() {
                        if let Ok(content) = std::fs::read_to_string(&pkg) {
                            if content.contains("jscodeshift") {
                                return d.clone();
                            }
                        }
                    }
                    if d.join("bridge/transform-host.js").is_file() {
                        return d.clone();
                    }
                    dir = d.parent().map(|p| p.to_path_buf());
                }
            }
        }
        if let Ok(manifest) = std::env::var("CARGO_MANIFEST_DIR") {
            if let Some(parent) = PathBuf::from(manifest).parent() {
                return parent.to_path_buf();
            }
        }
        std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."))
    }
    
    fn require_package_version(name: &str) -> String {
        // Walk node_modules resolving package.json for dependency version
        let root = package_root();
        let candidates = [
            root.join("node_modules").join(name).join("package.json"),
            root.join("node_modules")
                .join(name.replace('/', std::path::MAIN_SEPARATOR_STR))
                .join("package.json"),
        ];
        for c in &candidates {
            if let Ok(content) = std::fs::read_to_string(c) {
                if let Ok(v) = serde_json::from_str::<Value>(&content) {
                    if let Some(ver) = v.get("version").and_then(|x| x.as_str())
{
                        return ver.to_string();
                    }
                }
            }
        }
        // Nested package paths for scoped packages already handled
        // Try require.resolve style via node one-liner as last resort
        let output = process::Command::new("node")
            .arg("-e")
            .arg(format!(
                "try{{const 
p=require('{}/package.json');process.stdout.write(p.version||'')}catch(e){{try{{
let d=require('path').dirname(require.resolve('{}'));const 
fs=require('fs');const path=require('path');while(d!=='/'){{try{{const 
pkg=JSON.parse(fs.readFileSync(path.join(d,'package.json'),'utf8'));if(pkg.name=
=='{}'){{process.stdout.write(pkg.version||'');break}}}}catch(_){{}}d=path.dirna
me(d)}}}}catch(_){{}}}}",
                name, name, name
            ))
            .current_dir(&root)
            .output();
        if let Ok(out) = output {
            let s = String::from_utf8_lossy(&out.stdout).trim().to_string();
            if !s.is_empty() {
                return s;
            }
        }
        String::new()
    }
    
    fn version_string() -> String {
        let pkg_version = {
            let pkg = package_root().join("package.json");
            std::fs::read_to_string(pkg)
                .ok()
                .and_then(|c| serde_json::from_str::<Value>(&c).ok())
                .and_then(|v| v.get("version").and_then(|x| x.as_str()).map(|s| 
s.to_string()))
                .unwrap_or_else(|| "17.4.0".to_string())
        };
        let babel = require_package_version("@babel/core");
        let babylon = require_package_version("@babel/parser");
        let flow = require_package_version("flow-parser");
        let recast = require_package_version("recast");
        format!(
            "jscodeshift: {}\n - babel: {}\n - babylon: {}\n - flow: {}\n - 
recast: {}\n",
            pkg_version, babel, babylon, flow, recast
        )
    }
    
    fn version_cb() -> String {
        version_string()
    }
    
    fn main() {
        let option_defs = build_cli_options(version_cb);
    
        let parsed = match args::parse(option_defs, None) {
            Ok(p) => p,
            Err(e) => args::exit_with_parse_error(e),
        };
    
        let mut options = parsed.options;
