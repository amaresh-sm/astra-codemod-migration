    pub fn get_bool(opts: &HashMap<String, Value>, key: &str) -> bool {
        opts.get(key).and_then(|v| v.as_bool()).unwrap_or(false)
    }
    
    pub fn get_string(opts: &HashMap<String, Value>, key: &str) -> 
Option<String> {
        opts.get(key).and_then(|v| match v {
            Value::String(s) => Some(s.clone()),
            Value::Number(n) => Some(n.to_string()),
            _ => None,
        })
    }
    
    pub fn get_i64(opts: &HashMap<String, Value>, key: &str) -> Option<i64> {
        opts.get(key).and_then(|v| v.as_i64())
    }
    
    pub fn get_string_list(opts: &HashMap<String, Value>, key: &str) -> 
Vec<String> {
        match opts.get(key) {
            Some(Value::Array(arr)) => arr
                .iter()
                .filter_map(|v| v.as_str().map(|s| s.to_string()))
                .collect(),
            Some(Value::String(s)) => vec![s.clone()],
            _ => vec![],
        }
    }
    

