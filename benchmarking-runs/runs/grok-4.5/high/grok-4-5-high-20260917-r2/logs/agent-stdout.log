    //! Argument parser ported from jscodeshift `src/argsParser.js`.
    
    use serde_json::Value;
    use std::collections::HashMap;
    use std::env;
    use std::process;
    
    #[derive(Clone)]
    pub enum ProcessFn {
        Number,
        ParserConfig,
        Custom(fn(&str) -> Result<Value, String>),
    }
    
    #[derive(Clone)]
    pub struct OptionDef {
        pub key: String,
        pub full: String,
        pub abbr: Option<String>,
        pub flag: bool,
        pub list: bool,
        pub default: Option<Value>,
        pub default_help: Option<String>,
        pub choices: Option<Vec<Value>>,
        pub help: Option<String>,
        pub metavar: Option<String>,
        pub display_index: i32,
        pub process: Option<ProcessFn>,
        pub callback: Option<fn() -> String>,
    }
    
    #[derive(Debug)]
    pub struct ParseError {
        pub exit_code: i32,
        pub message: String,
    }
    
    #[derive(Debug, Clone)]
    pub struct ParsedArgs {
        pub options: HashMap<String, Value>,
        pub positional_arguments: Vec<Value>,
    }
    
    struct PreparedOption {
        def: OptionDef,
    }
    
    fn is_option(value: &str) -> bool {
        value.starts_with('-') && value != "-"
    }
    
    fn value_to_display(v: &Value) -> String {
        match v {
            Value::String(s) => s.clone(),
            Value::Bool(b) => b.to_string(),
            Value::Number(n) => n.to_string(),
            Value::Null => "null".to_string(),
            other => other.to_string(),
        }
    }
    
    fn format_option(option: &OptionDef) -> String {
        let mut text = String::from("  ");
        if let Some(ref abbr) = option.abbr {
            text.push('-');
            text.push_str(abbr);
            text.push_str(", ");
        } else {
            text.push_str("    ");
        }
        text.push_str("--");
        if option.flag {
            text.push_str("(no-)");
        }
        text.push_str(&option.full);
        if let Some(ref choices) = option.choices {
            text.push('=');
            let parts: Vec<String> = 
choices.iter().map(value_to_display).collect();
            text.push_str(&parts.join("|"));
        } else if let Some(ref metavar) = option.metavar {
            text.push('=');
            text.push_str(metavar);
        }
        if option.list {
            text.push_str(" ...");
        }
        if option.default_help.is_some() || option.default.is_some() || 
option.help.is_some() {
            text.push_str("  ");
            if text.len() < 32 {
                text.push_str(&" ".repeat(32 - text.len()));
            }
            let text_length = text.len();
            if let Some(ref help) = option.help {
                text.push_str(help);
            }
            if option.default_help.is_some() || option.default.is_some() {
                if option.help.is_some() {
                    text.push('\n');
                }
                text.push_str(&" ".repeat(text_length));
                let default_str = option
                    .default_help
                    .clone()
                    .or_else(|| option.default.as_ref().map(value_to_display))
                    .unwrap_or_default();
                text.push_str(&format!("(default: {})", default_str));
            }
        }
        text
    }
    
    pub fn get_help_text(options: &HashMap<String, OptionDef>) -> String {
        let mut opts: Vec<&OptionDef> = options.values().collect();
        opts.sort_by_key(|o| o.display_index);
    
        let formatted: Vec<String> = opts.iter().map(|o| 
format_option(o)).collect();
        let text = format!(
            r#"
    Usage: jscodeshift [OPTION]... PATH...
      or:  jscodeshift [OPTION]... -t TRANSFORM_PATH PATH...
      or:  jscodeshift [OPTION]... -t URL PATH...
      or:  jscodeshift [OPTION]... --stdin < file_list.txt
    
    Apply transform logic in TRANSFORM_PATH (recursively) to every PATH.
    If --stdin is set, each line of the standard input is used as a path.
    
    Options:
    "..." behind an option means that it can be supplied multiple times.
    All options are also passed to the transformer, which means you can supply 
custom options that are not listed here.
    
    {}"#,
            formatted.join("\n")
        );
        // trimLeft equivalent
        text.trim_start().to_string()
    }
    
    fn prepare_options(mut options: HashMap<String, OptionDef>) -> 
HashMap<String, PreparedOption> {
        options.insert(
            "help".to_string(),
            OptionDef {
                key: "help".to_string(),
                full: "help".to_string(),
                abbr: Some("h".to_string()),
                flag: false,
                list: false,
                default: None,
                default_help: None,
                choices: None,
                help: Some("print this help and exit".to_string()),
                metavar: None,
                display_index: 5,
                process: None,
                callback: None, // filled specially
            },
        );
    
        let mut prepared: HashMap<String, PreparedOption> = HashMap::new();
    
        let keys: Vec<String> = options.keys().cloned().collect();
        for option_name in keys {
            let mut option = options.remove(&option_name).unwrap();
            if option.full.is_empty() {
                option.full = option_name.clone();
            }
            option.key = option_name.clone();
    
            // Special help callback needs access to all options - handled in 
parse
            prepared.insert(
                format!("--{}", option.full),
                PreparedOption {
                    def: option.clone(),
                },
            );
            if let Some(ref abbr) = option.abbr {
                prepared.insert(
                    format!("-{}", abbr),
                    PreparedOption {
                        def: option.clone(),
                    },
                );
            }
            if option.flag {
                prepared.insert(
                    format!("--no-{}", option.full),
                    PreparedOption {
                        def: option.clone(),
                    },
                );
            }
        }
    
        prepared
    }
    
    fn validate_options(
        parsed: &HashMap<String, Value>,
        options: &HashMap<String, OptionDef>,
    ) -> Result<(), ParseError> {
        let mut errors = Vec::new();
        for (option_name, option) in options {
            if let Some(ref choices) = option.choices {
                if let Some(val) = parsed.get(option_name) {
                    if !choices.iter().any(|c| c == val) {
                        let choice_str: Vec<String> = 
choices.iter().map(value_to_display).collect();
                        errors.push(format!(
                            "Error: --{} must be one of the values {}",
                            option.full,
                            choice_str.join(",")
                        ));
                    }
                }
            }
        }
        if !errors.is_empty() {
            return Err(ParseError {
                exit_code: 1,
                message: format!(
                    "{}\n\n---\n\n{}",
                    errors.join("\n"),
                    get_help_text(options)
                ),
            });
        }
        Ok(())
    }
    
    fn process_value(process: &Option<ProcessFn>, value: &str) -> Result<Value, 
String> {
        match process {
            Some(ProcessFn::Number) => {
                // Number() in JS: Number("1") => 1, Number("abc") => NaN
                if let Ok(n) = value.parse::<i64>() {
                    Ok(Value::Number(n.into()))
                } else if let Ok(n) = value.parse::<f64>() {
                    Ok(serde_json::Number::from_f64(n)
                        .map(Value::Number)
                        .unwrap_or(Value::Null))
                } else {
                    // NaN becomes null in JSON; JS would still put NaN
                    Ok(Value::Null)
                }
            }
            Some(ProcessFn::ParserConfig) => {
                let content = std::fs::read_to_string(value)
                    .map_err(|e| format!("Failed to read parser config: {}", 
e))?;
                serde_json::from_str(&content)
                    .map_err(|e| format!("Failed to parse parser config JSON: 
{}", e))
            }
            Some(ProcessFn::Custom(f)) => f(value),
            None => {
                // Try JSON parse like unknown options
                match serde_json::from_str::<Value>(value) {
                    Ok(v) => Ok(v),
                    Err(_) => Ok(Value::String(value.to_string())),
                }
            }
        }
    }
    
    const MISSING_VALUE: &str = "__MISSING_VALUE__";
    
    pub fn parse(
        options: HashMap<String, OptionDef>,
        args: Option<Vec<String>>,
    ) -> Result<ParsedArgs, ParseError> {
        let args = args.unwrap_or_else(|| env::args().skip(1).collect());
    
        // Keep original defs for help/validation (before prepare mutates keys)
        let mut option_defs = options.clone();
        // Inject help
        option_defs.insert(
            "help".to_string(),
            OptionDef {
                key: "help".to_string(),
                full: "help".to_string(),
                abbr: Some("h".to_string()),
                flag: false,
                list: false,
                default: None,
                default_help: None,
                choices: None,
                help: Some("print this help and exit".to_string()),
                metavar: None,
                display_index: 5,
                process: None,
                callback: Some(|| String::new()), // placeholder
            },
        );
    
        let prepared = prepare_options(options);
    
        let mut parsed_options: HashMap<String, Value> = HashMap::new();
        let mut positional_arguments: Vec<Value> = Vec::new();
    
        for (option_name, option) in &option_defs {
            if option_name == "help" {
                continue;
            }
            if let Some(ref default) = option.default {
                parsed_options.insert(option_name.clone(), default.clone());
            } else if option.list {
                parsed_options.insert(option_name.clone(), 
Value::Array(vec![]));
            }
        }
    
        let mut i = 0;
        while i < args.len() {
            let arg = &args[i];
            if is_option(arg) {
                let mut option_name = arg.clone();
                let mut value: Option<String> = None;
    
                if let Some(index) = arg.find('=') {
                    option_name = arg[..index].to_string();
                    value = Some(arg[index + 1..].to_string());
                }
    
                let is_help = option_name == "--help" || option_name == "-h";
                if is_help {
                    return Err(ParseError {
                        exit_code: 0,
                        message: get_help_text(&option_defs),
                    });
                }
    
                // Check for version and other callbacks
                if let Some(prep) = prepared.get(&option_name) {
                    if let Some(cb) = prep.def.callback {
                        return Err(ParseError {
                            exit_code: 0,
                            message: cb(),
                        });
                    }
                }
    
                let mut option_def: OptionDef;
                let known = prepared.contains_key(&option_name);
    
                if known {
                    option_def = 
prepared.get(&option_name).unwrap().def.clone();
                } else {
                    // Unknown options are "passed along"
                    let real_option_name = option_name
                        .trim_start_matches('-')
                        .trim_start_matches("no-")
                        .to_string();
                    // More carefully strip -- or - and optional no-
                    let real_option_name = {
                        let s = option_name.as_str();
                        let s = if let Some(rest) = s.strip_prefix("--") {
                            rest
                        } else if let Some(rest) = s.strip_prefix('-') {
                            rest
                        } else {
                            s
                        };
                        if let Some(rest) = s.strip_prefix("no-") {
                            rest.to_string()
                        } else {
                            s.to_string()
                        }
                    };
    
                    let is_list = parsed_options.contains_key(&real_option_name)
                        && parsed_options.get(&real_option_name) != 
Some(&Value::Bool(true));
    
                    let flag = !parsed_options.contains_key(&real_option_name)
                        && value.is_none()
                        && i + 1 < args.len()
                        && is_option(&args[i + 1]);
    
                    // JS: flag: !parsedOptions.hasOwnProperty(realOptionName) 
&& value === null && isOption(args[i+1])
                    // Wait, re-read: `isOption(args[i+1])` - if NEXT is option,
it's a flag
                    // Actually: flag: !hasOwn && value === null && 
isOption(args[i+1])
                    // If next is option OR we're at end without value... hmm
                    // Looking again: `isOption(args[i+1])` - if the next arg is
an option, treat as flag.
                    // But if next is NOT option and value is null, it would 
consume next as value with process JSON.
                    // However if at end: args[i+1] is undefined, 
isOption(undefined) is false (regex on undefined).
                    // So at end with no value, flag=false, goes to else branch,
value stays null, sets missingValue.
    
                    // Wait again for the flag computation when next doesn't 
exist:
                    // In JS, args[i+1] is undefined, isOption(undefined): 
/^--?/.test(undefined) - test coerces to "undefined" string? 
                    // Actually String: RegExp.test converts to string. 
/^--?/.test(undefined) => /^--?/.test("undefined") => false
                    // So flag is false.
    
                    let flag = !parsed_options.contains_key(&real_option_name)
                        && value.is_none()
                        && (i + 1 >= args.len() || is_option(&args.get(i + 
1).cloned().unwrap_or_default()));
    
                    // Re-read original more carefully:
                    // flag: !parsedOptions.hasOwnProperty(realOptionName) &&
                    //       value === null &&
                    //       isOption(args[i+1]),
                    // 
                    // When at last arg: isOption(undefined) is false in JS:
                    // > /^--?/.test(undefined)
                    // false
                    // So flag=false when no next arg.
    
                    let flag = !parsed_options.contains_key(&real_option_name)
                        && value.is_none()
                        && i + 1 < args.len()
                        && is_option(&args[i + 1]);
    
                    option_def = OptionDef {
                        key: real_option_name.clone(),
                        full: real_option_name.clone(),
                        abbr: None,
                        flag,
                        list: is_list,
                        default: None,
                        default_help: None,
                        choices: None,
                        help: None,
                        metavar: None,
                        display_index: 0,
                        process: Some(ProcessFn::Custom(|v| {
                            match serde_json::from_str::<Value>(v) {
                                Ok(val) => Ok(val),
                                Err(_) => Ok(Value::String(v.to_string())),
                            }
                        })),
                        callback: None,
                    };
    
                    if is_list {
                        if let Some(current) = 
parsed_options.get(&real_option_name).cloned() {
                            if !current.is_array() {
                                if current == Value::Bool(true) {
                                    parsed_options
                                        .insert(real_option_name.clone(), 
Value::Array(vec![]));
                                } else {
                                    parsed_options.insert(
                                        real_option_name.clone(),
                                        Value::Array(vec![current]),
                                    );
                                }
                            }
                        }
                    }
                }
    
                if option_def.callback.is_some() {
                    // already handled above for known
                } else if option_def.flag {
                    let val = if option_name.starts_with("--no-") {
                        Value::Bool(false)
                    } else if let Some(ref v) = value {
                        Value::Bool(v == "1")
                    } else {
                        Value::Bool(true)
                    };
                    parsed_options.insert(option_def.key.clone(), val);
                } else {
                    let mut val = value;
                    if val.is_none() && i < args.len() - 1 && !is_option(&args[i
+ 1]) {
                        val = Some(args[i + 1].clone());
                        i += 1;
                    }
                    if let Some(ref v) = val {
                        let processed = match &option_def.process {
                            Some(ProcessFn::Number) => {
                                if let Ok(n) = v.parse::<i64>() {
                                    Value::Number(n.into())
                                } else if let Ok(n) = v.parse::<f64>() {
                                    serde_json::Number::from_f64(n)
                                        .map(Value::Number)
                                        .unwrap_or(Value::Null)
                                } else {
                                    Value::Null
                                }
                            }
                            Some(ProcessFn::ParserConfig) => {
                                match std::fs::read_to_string(v) {
                                    Ok(content) => match 
serde_json::from_str(&content) {
                                        Ok(json) => json,
                                        Err(e) => {
                                            return Err(ParseError {
                                                exit_code: 1,
                                                message: format!("{}\n", e),
                                            });
                                        }
                                    },
                                    Err(e) => {
                                        return Err(ParseError {
                                            exit_code: 1,
                                            message: format!("{}\n", e),
                                        });
                                    }
                                }
                            }
                            Some(ProcessFn::Custom(f)) => match f(v) {
                                Ok(x) => x,
                                Err(e) => {
                                    return Err(ParseError {
                                        exit_code: 1,
                                        message: e,
                                    });
                                }
                            },
                            None => Value::String(v.clone()),
                        };
                        if option_def.list {
                            let arr = parsed_options
                                .entry(option_def.key.clone())
                                .or_insert_with(|| Value::Array(vec![]));
                            if let Value::Array(ref mut a) = arr {
                                a.push(processed);
                            }
                        } else {
                            parsed_options.insert(option_def.key.clone(), 
processed);
                        }
                    } else {
                        parsed_options
                            .insert(option_def.key.clone(), 
Value::String(MISSING_VALUE.into()));
                    }
                }
                let _ = known; // silence
            } else {
                // positional
                if let Ok(n) = arg.parse::<i64>() {
                    if arg.chars().all(|c| c.is_ascii_digit()) {
                        positional_arguments.push(Value::Number(n.into()));
                    } else {
                        positional_arguments.push(Value::String(arg.clone()));
                    }
                } else {
                    positional_arguments.push(Value::String(arg.clone()));
                }
            }
            i += 1;
        }
    
        for (option_name, val) in &parsed_options {
            if val.as_str() == Some(MISSING_VALUE) {
                let full = option_defs
                    .get(option_name)
                    .map(|o| o.full.clone())
                    .unwrap_or_else(|| option_name.clone());
                return Err(ParseError {
                    exit_code: 1,
                    message: format!(
                        "Missing value: --{} requires a value\n\n---\n\n{}",
                        full,
                        get_help_text(&option_defs)
                    ),
                });
            }
        }
    
        // Build options map without help for validation
        let mut defs_for_validate = option_defs.clone();
        defs_for_validate.remove("help");
        validate_options(&parsed_options, &defs_for_validate)?;
    
        Ok(ParsedArgs {
            options: parsed_options,
            positional_arguments,
        })
    }
    
    pub fn exit_with_parse_error(e: ParseError) -> ! {
        if e.exit_code != 0 {
            eprint!("{}", e.message);
            if !e.message.ends_with('\n') {
                // original writes e.message as-is
            }
        } else {
            print!("{}", e.message);
        }
        process::exit(e.exit_code);
    }
    
