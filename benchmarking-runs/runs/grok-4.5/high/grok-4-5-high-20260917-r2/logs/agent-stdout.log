+314|                option_name = arg[..index].to_string();
+315|                value = Some(arg[index + 1..].to_string());
+316|            }
+317|
+318|            let is_help = option_name == "--help" || option_name == "-h";
+319|            if is_help {
+320|                return Err(ParseError {
+321|                    exit_code: 0,
+322|                    message: get_help_text(&option_defs),
+323|                });
+324|            }
+325|
+326|            // Check for version and other callbacks
+327|            if let Some(prep) = prepared.get(&option_name) {
+328|                if let Some(cb) = prep.def.callback {
+329|                    return Err(ParseError {
+330|                        exit_code: 0,
+331|                        message: cb(),
+332|                    });
+333|                }
+334|            }
+335|
+336|            let mut option_def: OptionDef;
+337|            let known = prepared.contains_key(&option_name);
+338|
+339|            if known {
+340|                option_def = 
prepared.get(&option_name).unwrap().def.clone();
+341|            } else {
+342|                // Unknown options are "passed along"
+343|                let real_option_name = option_name
+344|                    .trim_start_matches('-')
+345|                    .trim_start_matches("no-")
+346|                    .to_string();
+347|                // More carefully strip -- or - and optional no-
+348|                let real_option_name = {
+349|                    let s = option_name.as_str();
+350|                    let s = if let Some(rest) = s.strip_prefix("--") {
+351|                        rest
+352|                    } else if let Some(rest) = s.strip_prefix('-') {
+353|                        rest
+354|                    } else {
+355|                        s
+356|                    };
+357|                    if let Some(rest) = s.strip_prefix("no-") {
+358|                        rest.to_string()
+359|                    } else {
+360|                        s.to_string()
+361|                    }
+362|                };
+363|
+364|                let is_list = 
parsed_options.contains_key(&real_option_name)
+365|                    && parsed_options.get(&real_option_name) != 
Some(&Value::Bool(true));
+366|
+367|                let flag = !parsed_options.contains_key(&real_option_name)
+368|                    && value.is_none()
+369|                    && i + 1 < args.len()
+370|                    && is_option(&args[i + 1]);
+371|
+372|                // JS: flag: !parsedOptions.hasOwnProperty(realOptionName) 
&& value === null && isOption(args[i+1])
+373|                // Wait, re-read: `isOption(args[i+1])` - if NEXT is 
option, it's a flag
+374|                // Actually: flag: !hasOwn && value === null && 
isOption(args[i+1])
+375|                // If next is option OR we're at end without value... hmm
+376|                // Looking again: `isOption(args[i+1])` - if the next arg 
is an option, treat as flag.
+377|                // But if next is NOT option and value is null, it would 
consume next as value with process JSON.
+378|                // However if at end: args[i+1] is undefined, 
isOption(undefined) is false (regex on undefined).
+379|                // So at end with no value, flag=false, goes to else 
branch, value stays null, sets missingValue.
+380|
+381|                // Wait again for the flag computation when next doesn't 
exist:
+382|                // In JS, args[i+1] is undefined, isOption(undefined): 
/^--?/.test(undefined) - test coerces to "undefined" string? 
+383|                // Actually String: RegExp.test converts to string. 
/^--?/.test(undefined) => /^--?/.test("undefined") => false
+384|                // So flag is false.
+385|
+386|                let flag = !parsed_options.contains_key(&real_option_name)
+387|                    && value.is_none()
+388|                    && (i + 1 >= args.len() || is_option(&args.get(i + 
1).cloned().unwrap_or_default()));
+389|
+390|                // Re-read original more carefully:
+391|                // flag: !parsedOptions.hasOwnProperty(realOptionName) &&
+392|                //       value === null &&
+393|                //       isOption(args[i+1]),
+394|                // 
+395|                // When at last arg: isOption(undefined) is false in JS:
+396|                // > /^--?/.test(undefined)
+397|                // false
+398|                // So flag=false when no next arg.
+399|
+400|                let flag = !parsed_options.contains_key(&real_option_name)
+401|                    && value.is_none()
+402|                    && i + 1 < args.len()
+403|                    && is_option(&args[i + 1]);
+404|
+405|                option_def = OptionDef {
+406|                    key: real_option_name.clone(),
+407|                    full: real_option_name.clone(),
+408|                    abbr: None,
+409|                    flag,
+410|                    list: is_list,
+411|                    default: None,
+412|                    default_help: None,
+413|                    choices: None,
+414|                    help: None,
+415|                    metavar: None,
+416|                    display_index: 0,
+417|                    process: Some(ProcessFn::Custom(|v| {
+418|                        match serde_json::from_str::<Value>(v) {
+419|                            Ok(val) => Ok(val),
+420|                            Err(_) => Ok(Value::String(v.to_string())),
+421|                        }
+422|                    })),
+423|                    callback: None,
+424|                };
+425|
+426|                if is_list {
+427|                    if let Some(current) = 
parsed_options.get(&real_option_name).cloned() {
+428|                        if !current.is_array() {
+429|                            if current == Value::Bool(true) {
+430|                                parsed_options
+431|                                    .insert(real_option_name.clone(), 
Value::Array(vec![]));
+432|                            } else {
+433|                                parsed_options.insert(
+434|                                    real_option_name.clone(),
+435|                                    Value::Array(vec![current]),
+436|                                );
+437|                            }
+438|                        }
+439|                    }
+440|                }
+441|            }
+442|
+443|            if option_def.callback.is_some() {
+444|                // already handled above for known
+445|            } else if option_def.flag {
+446|                let val = if option_name.starts_with("--no-") {
+447|                    Value::Bool(false)
+448|                } else if let Some(ref v) = value {
+449|                    Value::Bool(v == "1")
+450|                } else {
+451|                    Value::Bool(true)
+452|                };
+453|                parsed_options.insert(option_def.key.clone(), val);
+454|            } else {
+455|                let mut val = value;
+456|                if val.is_none() && i < args.len() - 1 && 
!is_option(&args[i + 1]) {
+457|                    val = Some(args[i + 1].clone());
+458|                    i += 1;
+459|                }
+460|                if let Some(ref v) = val {
+461|                    let processed = match &option_def.process {
+462|                        Some(ProcessFn::Number) => {
+463|                            if let Ok(n) = v.parse::<i64>() {
+464|                                Value::Number(n.into())
+465|                            } else if let Ok(n) = v.parse::<f64>() {
+466|                                serde_json::Number::from_f64(n)
+467|                                    .map(Value::Number)
+468|                                    .unwrap_or(Value::Null)
+469|                            } else {
+470|                                Value::Null
+471|                            }
+472|                        }
+473|                        Some(ProcessFn::ParserConfig) => {
+474|                            match std::fs::read_to_string(v) {
+475|                                Ok(content) => match 
serde_json::from_str(&content) {
+476|                                    Ok(json) => json,
+477|                                    Err(e) => {
+478|                                        return Err(ParseError {
+479|                                            exit_code: 1,
+480|                                            message: format!("{}\n", e),
+481|                                        });
+482|                                    }
+483|                                },
+484|                                Err(e) => {
+485|                                    return Err(ParseError {
+486|                                        exit_code: 1,
+487|                                        message: format!("{}\n", e),
+488|                                    });
+489|                                }
+490|                            }
+491|                        }
+492|                        Some(ProcessFn::Custom(f)) => match f(v) {
+493|                            Ok(x) => x,
+494|                            Err(e) => {
+495|                                return Err(ParseError {
+496|                                    exit_code: 1,
+497|                                    message: e,
+498|                                });
+499|                            }
+500|                        },
+501|                        None => Value::String(v.clone()),
+502|                    };
+503|                    if option_def.list {
+504|                        let arr = parsed_options
+505|                            .entry(option_def.key.clone())
+506|                            .or_insert_with(|| Value::Array(vec![]));
+507|                        if let Value::Array(ref mut a) = arr {
+508|                            a.push(processed);
+509|                        }
+510|                    } else {
+511|                        parsed_options.insert(option_def.key.clone(), 
processed);
+512|                    }
+513|                } else {
+514|                    parsed_options
+515|                        .insert(option_def.key.clone(), 
Value::String(MISSING_VALUE.into()));
+516|                }
+517|            }
+518|            let _ = known; // silence
+519|        } else {
+520|            // positional
+521|            if let Ok(n) = arg.parse::<i64>() {
+522|                if arg.chars().all(|c| c.is_ascii_digit()) {
+523|                    positional_arguments.push(Value::Number(n.into()));
+524|                } else {
+525|                    positional_arguments.push(Value::String(arg.clone()));
+526|                }
+527|            } else {
+528|                positional_arguments.push(Value::String(arg.clone()));
+529|            }
+530|        }
+531|        i += 1;
+532|    }
+533|
+534|    for (option_name, val) in &parsed_options {
+535|        if val.as_str() == Some(MISSING_VALUE) {
+536|            let full = option_defs
+537|                .get(option_name)
+538|                .map(|o| o.full.clone())
+539|                .unwrap_or_else(|| option_name.clone());
+540|            return Err(ParseError {
+541|                exit_code: 1,
+542|                message: format!(
+543|                    "Missing value: --{} requires a value\n\n---\n\n{}",
+544|                    full,
+545|                    get_help_text(&option_defs)
+546|                ),
+547|            });
+548|        }
+549|    }
+550|
+551|    // Build options map without help for validation
+552|    let mut defs_for_validate = option_defs.clone();
+553|    defs_for_validate.remove("help");
+554|    validate_options(&parsed_options, &defs_for_validate)?;
+555|
+556|    Ok(ParsedArgs {
+557|        options: parsed_options,
+558|        positional_arguments,
+559|    })
+560|}
