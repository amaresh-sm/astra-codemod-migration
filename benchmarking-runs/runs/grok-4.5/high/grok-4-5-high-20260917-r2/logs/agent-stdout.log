JSON.stringify(v) : String(v));
  }
  for (const p of paths) {
    args.push(p);
  }
  return args;
}

function run(transformFile, paths, options) {
  options = options || {};
  // Programmatic API keeps JS implementation for Promise return value 
compatibility.
  // The CLI uses the Rust binary directly.
  if (process.env.JSCODESHIFT_FORCE_RUST === '1') {
    const bin = findRustBinary();
    if (bin) {
