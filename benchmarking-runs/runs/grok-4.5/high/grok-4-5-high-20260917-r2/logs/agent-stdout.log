+942|pub fn get_bool(opts: &HashMap<String, Value>, key: &str) -> bool {
+943|    opts.get(key).and_then(|v| v.as_bool()).unwrap_or(false)
+944|}
+945|
+946|pub fn get_string(opts: &HashMap<String, Value>, key: &str) -> 
Option<String> {
+947|    opts.get(key).and_then(|v| match v {
+948|        Value::String(s) => Some(s.clone()),
+949|        Value::Number(n) => Some(n.to_string()),
+950|        _ => None,
+951|    })
