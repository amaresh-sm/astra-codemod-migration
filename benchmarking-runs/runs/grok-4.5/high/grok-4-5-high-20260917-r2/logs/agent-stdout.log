    //! Runner ported from `src/Runner.js`.
    
    use crate::args::{self, get_bool, get_i64, get_string, get_string_list};
    use crate::ignore;
    use serde_json::{json, Value};
    use std::collections::HashMap;
    use std::io::{BufRead, BufReader, Write};
    use std::path::{Path, PathBuf};
    use std::process::{Child, Command, Stdio};
    use std::sync::atomic::{AtomicUsize, Ordering};
    use std::sync::{Arc, Mutex};
    use std::thread;
    use std::time::Instant;
    
    const CHUNK_SIZE: usize = 50;
    
    fn available_cpus() -> usize {
        std::cmp::max(num_cpus::get().saturating_sub(1), 1)
    }
    
    fn line_break(s: &str) -> String {
        if s.ends_with('\n') {
            s.to_string()
        } else {
            format!("{}\n", s)
        }
    }
    
    // ANSI colors approximating picocolors when stdout is a TTY
    fn use_color() -> bool {
        atty::is(atty::Stream::Stdout) && std::env::var_os("NO_COLOR").is_none()
    }
    
    fn bg_green(s: &str) -> String {
        if use_color() {
            format!("\x1b[42m\x1b[37m{}\x1b[0m", s)
        } else {
            s.to_string()
        }
    }
    fn bg_yellow(s: &str) -> String {
        if use_color() {
            format!("\x1b[43m\x1b[37m{}\x1b[0m", s)
        } else {
            s.to_string()
        }
    }
    fn bg_red(s: &str) -> String {
        if use_color() {
            format!("\x1b[41m\x1b[37m{}\x1b[0m", s)
        } else {
            s.to_string()
        }
    }
    fn bg_blue(s: &str) -> String {
        if use_color() {
            format!("\x1b[44m\x1b[37m{}\x1b[0m", s)
        } else {
            s.to_string()
        }
    }
    fn red(s: &str) -> String {
        if use_color() {
            format!("\x1b[31m{}\x1b[0m", s)
        } else {
            s.to_string()
        }
    }
    fn yellow(s: &str) -> String {
        if use_color() {
            format!("\x1b[33m{}\x1b[0m", s)
        } else {
            s.to_string()
        }
    }
    fn green(s: &str) -> String {
        if use_color() {
            format!("\x1b[32m{}\x1b[0m", s)
        } else {
            s.to_string()
        }
    }
    fn blue(s: &str) -> String {
        if use_color() {
            format!("\x1b[34m{}\x1b[0m", s)
        } else {
            s.to_string()
        }
    }
    
    fn log_ok(msg: &str, verbose: i64) {
        if verbose >= 2 {
            print!("{}{}", bg_green(" OKK "), msg);
            let _ = std::io::stdout().flush();
        }
    }
    fn log_nochange(msg: &str, verbose: i64) {
        if verbose >= 1 {
            print!("{}{}", bg_yellow(" NOC "), msg);
            let _ = std::io::stdout().flush();
        }
    }
    fn log_skip(msg: &str, verbose: i64) {
        if verbose >= 1 {
            print!("{}{}", bg_yellow(" SKIP "), msg);
            let _ = std::io::stdout().flush();
        }
    }
    fn log_error(msg: &str, verbose: i64) {
        if verbose >= 0 {
            print!("{}{}", bg_red(" ERR "), msg);
            let _ = std::io::stdout().flush();
        }
    }
    
    fn report(file: &str, msg: &str) {
        print!("{}", line_break(&format!("{}{} {}", bg_blue(" REP "), file, 
msg)));
        let _ = std::io::stdout().flush();
    }
    
    fn show_file_stats(error: usize, nochange: usize, skip: usize, ok: usize) {
        print!(
            "Results: \n{}{}{}{}",
            red(&format!("{} errors\n", error)),
            yellow(&format!("{} unmodified\n", nochange)),
            yellow(&format!("{} skipped\n", skip)),
            green(&format!("{} ok\n", ok)),
        );
    }
    
    fn show_stats(stats: &HashMap<String, i64>) {
        let mut names: Vec<&String> = stats.keys().collect();
        names.sort();
        if !names.is_empty() {
            print!("{}", blue("Stats: \n"));
        }
        for name in names {
            println!("{}: {}", name, stats[name]);
        }
    }
    
    fn collect_dir_files(dir: &Path, acc: &mut Vec<String>) {
        let entries = match std::fs::read_dir(dir) {
            Ok(e) => e,
            Err(_) => return,
        };
        for entry in entries.flatten() {
            let name = entry.path();
            let name_str = name.to_string_lossy().to_string();
            // Match JS path.join behavior - keep as-is
            match std::fs::symlink_metadata(&name).or_else(|_| 
std::fs::metadata(&name)) {
                Err(_) => {
                    println!("Skipping path \"{}\" which does not exist.", 
name_str);
                }
                Ok(stats) => {
                    if ignore::should_ignore(&name_str) {
                        continue;
                    } else if stats.is_dir() {
                        // JS: dirFiles(name + '/', ...)
                        collect_dir_files(&name, acc);
                    } else {
                        acc.push(name_str);
                    }
                }
            }
        }
    }
    
    fn get_all_files(paths: &[String], extensions: &Option<Vec<String>>) -> 
Vec<String> {
        let mut result = Vec::new();
        for file in paths {
            if file.is_empty() {
                continue;
            }
            let path = Path::new(file);
            let meta = match std::fs::symlink_metadata(path).or_else(|_| 
std::fs::metadata(path)) {
                Ok(m) => m,
                Err(_) => {
                    eprint!("Skipping path {} which does not exist. \n", file);
                    continue;
                }
            };
            if meta.is_dir() {
                let mut files = Vec::new();
                collect_dir_files(path, &mut files);
                for f in files {
                    if extension_ok(&f, extensions) {
                        result.push(f);
                    }
                }
            } else if !extension_ok(file, extensions) || 
ignore::should_ignore(file) {
                // ignore
            } else {
                result.push(file.clone());
            }
        }
        result
    }
    
    fn extension_ok(name: &str, extensions: &Option<Vec<String>>) -> bool {
        match extensions {
            None => true,
            Some(exts) => {
                let ext = Path::new(name)
                    .extension()
                    .map(|e| format!(".{}", e.to_string_lossy()))
                    .unwrap_or_default();
                exts.iter().any(|e| e == &ext)
            }
        }
    }
    
    fn find_package_root() -> PathBuf {
        // Prefer path relative to this executable
        if let Ok(exe) = std::env::current_exe() {
            // exe might be target/release/jscodeshift or bin/jscodeshift or 
node_modules/.bin
            let mut dir = exe.parent().map(|p| p.to_path_buf());
            for _ in 0..8 {
                if let Some(ref d) = dir {
                    // package root has package.json with name jscodeshift OR 
bridge/transform-host.js
                    let bridge = d.join("bridge/transform-host.js");
                    if bridge.is_file() {
                        return d.clone();
                    }
                    let pkg = d.join("package.json");
                    if pkg.is_file() {
                        if let Ok(content) = std::fs::read_to_string(&pkg) {
                            if content.contains("\"name\": \"jscodeshift\"")
                                || content.contains("\"name\":\"jscodeshift\"")
                            {
                                return d.clone();
                            }
                        }
                    }
                    dir = d.parent().map(|p| p.to_path_buf());
                }
            }
        }
        // Fallback: CARGO / workspace
        if let Ok(manifest) = std::env::var("CARGO_MANIFEST_DIR") {
            let p = PathBuf::from(manifest);
            if let Some(parent) = p.parent() {
                return parent.to_path_buf();
            }
        }
        std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."))
    }
    
    fn bridge_path() -> PathBuf {
        find_package_root().join("bridge/transform-host.js")
    }
    
    struct Worker {
        child: Child,
        id: usize,
    }
    
    fn spawn_worker(transform_file: &str, babel: bool) -> 
std::io::Result<Worker> {
        static NEXT_ID: AtomicUsize = AtomicUsize::new(0);
        let id = NEXT_ID.fetch_add(1, Ordering::SeqCst);
        let bridge = bridge_path();
        let babel_arg = if babel { "babel" } else { "no-babel" };
        let child = Command::new("node")
            .arg(&bridge)
            .arg(transform_file)
            .arg(babel_arg)
            .stdin(Stdio::piped())
            .stdout(Stdio::piped())
            .stderr(Stdio::inherit())
            .spawn()?;
        Ok(Worker { child, id })
    }
    
    fn handle_message(
        msg: &Value,
        file_counters: &Arc<Mutex<HashMap<String, usize>>>,
        stats_counter: &Arc<Mutex<HashMap<String, i64>>>,
        verbose: i64,
    ) {
        let action = msg.get("action").and_then(|a| a.as_str()).unwrap_or("");
        match action {
            "status" => {
                let status = msg
                    .get("status")
                    .and_then(|s| s.as_str())
                    .unwrap_or("error");
                let m = msg.get("msg").and_then(|s| s.as_str()).unwrap_or("");
                {
                    let mut c = file_counters.lock().unwrap();
                    *c.entry(status.to_string()).or_insert(0) += 1;
                }
                let msg_lb = line_break(m);
                match status {
                    "ok" => log_ok(&msg_lb, verbose),
                    "nochange" => log_nochange(&msg_lb, verbose),
                    "skip" => log_skip(&msg_lb, verbose),
                    "error" => log_error(&msg_lb, verbose),
                    _ => {}
                }
            }
            "update" => {
                let name = msg
                    .get("name")
                    .and_then(|s| s.as_str())
                    .unwrap_or("")
                    .to_string();
                let quantity = msg.get("quantity").and_then(|q| 
q.as_i64()).unwrap_or(1);
                let mut s = stats_counter.lock().unwrap();
                *s.entry(name).or_insert(0) += quantity;
            }
            "report" => {
                let file = msg.get("file").and_then(|s| 
s.as_str()).unwrap_or("");
                let m = msg.get("msg").and_then(|s| s.as_str()).unwrap_or("");
                report(file, m);
            }
            _ => {}
        }
    }
    
    /// Download HTTP(S) transform to a temp file, return path.
    fn download_transform(url: &str) -> Result<PathBuf, String> {
        let resp = ureq::get(url)
            .call()
            .map_err(|e| format!("Failed to download transform: {}", e))?;
        let mut reader = resp.into_reader();
        let ext = Path::new(url)
            .extension()
            .map(|e| format!(".{}", e.to_string_lossy()))
            .unwrap_or_else(|| ".js".to_string());
        let mut tmp = tempfile::Builder::new()
            .prefix("jscodeshift")
            .suffix(&ext)
            .tempfile()
            .map_err(|e| e.to_string())?;
        std::io::copy(&mut reader, tmp.as_file_mut()).map_err(|e| 
e.to_string())?;
        let path = tmp.into_temp_path();
        // Keep the file
        let kept = path.keep().map_err(|e| e.error.to_string())?;
        Ok(kept)
    }
    
    pub fn run(transform_file: &str, paths: Vec<String>, options: 
&HashMap<String, Value>) -> Option<Value> {
        let cpus = match get_i64(options, "cpus") {
            Some(n) if n > 0 => std::cmp::min(available_cpus(), n as usize),
            _ => available_cpus(),
        };
    
        let extensions = get_string(options, "extensions").map(|ext| {
            ext.split(',')
                .map(|e| format!(".{}", e.trim()))
                .collect::<Vec<_>>()
        });
    
        let file_counters: Arc<Mutex<HashMap<String, usize>>> = 
Arc::new(Mutex::new(HashMap::from([
            ("error".into(), 0usize),
            ("ok".into(), 0),
            ("nochange".into(), 0),
            ("skip".into(), 0),
        ])));
        let stats_counter: Arc<Mutex<HashMap<String, i64>>> = 
Arc::new(Mutex::new(HashMap::new()));
        let start = Instant::now();
    
        ignore::reset();
        // options.ignoreSet is not from CLI but may be programmatic
        let ignore_set = get_string_list(options, "ignoreSet");
        ignore::add_from_input(&ignore_set);
        let ignore_pattern = get_string_list(options, "ignorePattern");
        ignore::add_from_input(&ignore_pattern);
        let ignore_config = get_string_list(options, "ignoreConfig");
        ignore::add_from_file(&ignore_config);
    
        if get_bool(options, "gitignore") {
            ignore::add_gitignore_cwd();
        }
    
        let transform_path = if transform_file.starts_with("http://")
            || transform_file.starts_with("https://")
        {
            match download_transform(transform_file) {
                Ok(p) => p.to_string_lossy().to_string(),
                Err(e) => {
                    eprint!("ERROR {}\n", e);
                    return None;
                }
            }
        } else if !Path::new(transform_file).exists() {
            eprint!(
                "{} Transform file {} does not exist \n",
                bg_red("ERROR"),
                transform_file
            );
            return None;
        } else {
            transform_file.to_string()
        };
    
        let files = get_all_files(&paths, &extensions);
        let num_files = files.len();
    
        if num_files == 0 {
            print!("No files selected, nothing to do. \n");
            return Some(json!({
                "stats": {},
                "timeElapsed": format!("{:.3}", start.elapsed().as_secs_f64()),
                "error": 0,
                "ok": 0,
                "nochange": 0,
                "skip": 0,
            }));
        }
    
        let run_in_band = get_bool(options, "runInBand");
        let silent = get_bool(options, "silent");
        let dry = get_bool(options, "dry");
        let verbose = get_i64(options, "verbose").unwrap_or(0);
        let babel = options
            .get("babel")
            .and_then(|v| v.as_bool())
            .unwrap_or(true);
    
        let processes = if run_in_band {
            1
        } else {
            std::cmp::min(num_files, cpus)
        };
        let chunk_size = if processes > 1 {
            std::cmp::min((num_files + processes - 1) / processes, CHUNK_SIZE)
        } else {
            num_files
        };
    
        if !silent {
            print!("Processing {} files... \n", files.len());
            if !run_in_band {
                print!("Spawning {} workers...\n", processes);
            }
            if dry {
                print!("{}", green("Running in dry mode, no files will be 
written! \n"));
            }
        }
    
        // Shared work queue
        let file_index = Arc::new(Mutex::new(0usize));
        let files = Arc::new(files);
    
        let next_chunk = {
            let files = Arc::clone(&files);
            let file_index = Arc::clone(&file_index);
            let silent = silent;
            let run_in_band = run_in_band;
            move || -> Vec<String> {
                let mut idx = file_index.lock().unwrap();
                let start_i = *idx;
                if start_i >= files.len() {
                    return vec![];
                }
                let end = std::cmp::min(start_i + chunk_size, files.len());
                if !silent && !run_in_band && start_i < files.len() {
                    print!(
                        "Sending {} files to free worker...\n",
                        end - start_i
                    );
                }
                let chunk = files[start_i..end].to_vec();
                *idx = end;
                chunk
            }
        };
    
        // Options object to send to workers (as JSON)
        let options_json = Value::Object(options.iter().map(|(k, v)| (k.clone(),
v.clone())).collect());
    
        let mut handles = Vec::new();
    
        for _ in 0..processes {
            let transform_path = transform_path.clone();
            let next_chunk = next_chunk.clone();
            let options_json = options_json.clone();
            let file_counters = Arc::clone(&file_counters);
            let stats_counter = Arc::clone(&stats_counter);
            let verbose = verbose;
            let babel = babel;
    
            let handle = thread::spawn(move || {
                let mut worker = match spawn_worker(&transform_path, babel) {
                    Ok(w) => w,
                    Err(e) => {
                        eprintln!("Failed to spawn worker: {}", e);
                        return;
                    }
                };
    
                let mut stdin = worker.child.stdin.take().expect("stdin");
                let stdout = worker.child.stdout.take().expect("stdout");
                let mut reader = BufReader::new(stdout);
    
                // Send initial chunk
                let mut send_files = |files: Vec<String>| -> bool {
                    let msg = json!({
                        "files": files,
                        "options": options_json,
                    });
                    if writeln!(stdin, "{}", msg).is_err() {
                        return false;
                    }
                    let _ = stdin.flush();
                    true
                };
    
                let initial = next_chunk();
                if initial.is_empty() {
                    // tell worker to finish
                    let _ = writeln!(stdin, "{}", json!({"files": [], "options":
options_json}));
                    let _ = stdin.flush();
                    let _ = worker.child.wait();
                    return;
                }
                if !send_files(initial) {
                    return;
                }
    
                let mut line = String::new();
                loop {
                    line.clear();
                    match reader.read_line(&mut line) {
                        Ok(0) => break, // EOF
                        Ok(_) => {
                            let trimmed = line.trim();
                            if trimmed.is_empty() {
                                continue;
                            }
                            let msg: Value = match serde_json::from_str(trimmed)
{
                                Ok(m) => m,
                                Err(_) => continue,
                            };
                            let action = msg.get("action").and_then(|a| 
a.as_str()).unwrap_or("");
                            if action == "free" {
                                let chunk = next_chunk();
                                if chunk.is_empty() {
                                    // Signal done - empty files causes worker 
finish
                                    let _ = send_files(vec![]);
                                    // Read until process exits; continue 
reading messages
                                } else {
                                    if !send_files(chunk) {
                                        break;
                                    }
                                }
                            } else {
                                handle_message(&msg, &file_counters, 
&stats_counter, verbose);
                            }
                        }
                        Err(_) => break,
                    }
                }
                let _ = worker.child.wait();
            });
            handles.push(handle);
        }
    
        for h in handles {
            let _ = h.join();
        }
    
        let elapsed = start.elapsed().as_secs_f64();
        let time_elapsed = format!("{:.3}", elapsed);
    
        let counters = file_counters.lock().unwrap().clone();
        let stats = stats_counter.lock().unwrap().clone();
        let error = *counters.get("error").unwrap_or(&0);
        let ok = *counters.get("ok").unwrap_or(&0);
        let nochange = *counters.get("nochange").unwrap_or(&0);
        let skip = *counters.get("skip").unwrap_or(&0);
    
        if !silent {
            print!("All done. \n");
            show_file_stats(error, nochange, skip, ok);
            show_stats(&stats);
            print!("Time elapsed: {}seconds \n", time_elapsed);
    
            if get_bool(options, "failOnError") && error > 0 {
                std::process::exit(1);
            }
        }
    
        Some(json!({
            "stats": stats,
            "timeElapsed": time_elapsed,
            "error": error,
            "ok": ok,
            "nochange": nochange,
            "skip": skip,
        }))
    }
    

