option.default.is_some();
        if has_default || option.help.is_some() {
            text.push_str("  ");
            // JS counts UTF-16 code units; option metadata is ASCII so chars 
suffice.
            let len = text.chars().count();
            if len < 32 {
                text.push_str(&" ".repeat(32 - len));
            }
            let text_length = text.chars().count();
            if let Some(help) = option.help {
                text.push_str(help);
            }
            if has_default {
                if option.help.is_some() {
