            "cntrl" => r"\x00-\x1F\x7F",
            "digit" => "0-9",
            "graph" => r"\x21-\x7E",
            "lower" => "a-z",
            "print" => r"\x20-\x7E ",
            "punct" => r#"\-!"#$%&'()\*+,./:;<=>?@[\]^_`{|}~"#,
            "space" => " \\t\\r\\n\\v\\f",
            "upper" => "A-Z",
            "word" => "A-Za-z0-9_",
            "xdigit" => "A-Fa-f0-9",
            _ => return None,
        })
    }
    
    /// A compiled glob, mirroring one `picomatch(pattern, { dot: true })` 
matcher.
    pub struct Matcher {
        regex: Regex,
        /// The glob itself; `picomatch.test` short-circuits on a literal 
equality
        /// check before ever consulting the regex.
        glob: String,
        /// Retained so the tests can assert byte-identical regex sources.
        source: String,
    }
    
    impl Matcher {
        /// Compiles a glob. Returns `None` for inputs picomatch rejects (an 
empty
        /// pattern) or whose generated source cannot be compiled.
        pub fn new(pattern: &str) -> Option<Self> {
            let source = make_re(pattern)?;
            // picomatch.toRegex swallows compilation errors and substitutes
            // `/$^/`, a regex that never matches.
            let regex = Regex::new(&source).or_else(|_| Regex::new("$^")).ok()?;
            Some(Self { regex, glob: pattern.to_string(), source })
        }
    
        pub fn source(&self) -> &str {
            &self.source
        }
    
        /// `picomatch.test(path, regex, { dot: true }, { glob })`
        pub fn is_match(&self, path: &str) -> bool {
            if path.is_empty() {
                return false;
            }
            path == self.glob || self.regex.is_match(path).unwrap_or(false)
        }
    }
    
    /// `picomatch.makeRe(input, { dot: true })`
    pub fn make_re(input: &str) -> Option<String> {
        if input.is_empty() || input.len() > MAX_LENGTH {
            return None;
        }
        // `makeRe` tries `parse.fastpaths` first for patterns starting `.` or 
`*`.
        // Its output is already wrapped by `parse.fastpaths`' caller? No: 
fastpaths
        // returns a bare body and `compileRe` wraps it, but `parse`'s *inner*
        // fastpath wraps its own output, so that body gets wrapped twice.
        if input.starts_with('.') || input.starts_with('*') {
            if let Some(source) = fastpaths(input) {
                return Some(compile_re(&source, false));
            }
        }
        let (output, negated) = parse(input);
        Some(compile_re(&output, negated))
    }
    
    /// `picomatch.compileRe`
    fn compile_re(output: &str, negated: bool) -> String {
        let source = format!("^(?:{output})$");
        if negated {
            format!("^(?!{source}).*$")
        } else {
            source
        }
    }
    
    /// `utils.wrapOutput`
    fn wrap_output(input: &str, negated: bool) -> String {
        let output = format!("^(?:{input})$");
        if negated {
            format!("(?:^(?!{output}).*$)")
        } else {
            output
        }
    }
    
    /// `utils.removePrefix`
    fn remove_prefix(input: &str) -> &str {
        input.strip_prefix("./").unwrap_or(input)
    }
    
    /// `utils.escapeLast`
    fn escape_last(input: &str, ch: char) -> String {
        let bytes = input.as_bytes();
        let mut search = input.len();
        while let Some(idx) = input[..search].rfind(ch) {
            if idx > 0 && bytes[idx - 1] == b'\\' {
                search = idx;
                continue;
            }
            return format!("{}\\{}", &input[..idx], &input[idx..]);
        }
        input.to_string()
    }
    
    /// `constants.REPLACEMENTS`
    fn replacement(input: &str) -> &str {
        match input {
            "***" => "*",
            "**/**" | "**/**/**" => "**",
            other => other,
        }
    }
    
    /// `parse.fastpaths(input, { dot: true })`
    fn fastpaths(input: &str) -> Option<String> {
        let input = replacement(input);
        if input.len() > MAX_LENGTH {
            return None;
        }
        let output = remove_prefix(input);
        let mut source = fastpath_create(output)?;
        source.push_str(&format!("{SLASH_LITERAL}?"));
        Some(source)
    }
    
    fn fastpath_create(str: &str) -> Option<String> {
        let globstar = globstar();
        Some(match str {
            "*" => format!("{NO_DOTS}{ONE_CHAR}{STAR}"),
            ".*" => format!("{DOT_LITERAL}{ONE_CHAR}{STAR}"),
            "*.*" => format!("{NO_DOTS}{STAR}{DOT_LITERAL}{ONE_CHAR}{STAR}"),
            "*/*" => 
format!("{NO_DOTS}{STAR}{SLASH_LITERAL}{ONE_CHAR}{NO_DOTS_SLASH}{STAR}"),
            "**" => format!("{NO_DOTS}{globstar}"),
            "**/*" => {
                format!("(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{NO_DOTS_SLASH}{
ONE_CHAR}{STAR}")
            }
            "**/*.*" => format!(
                "(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{NO_DOTS_SLASH}{STAR}{DO
T_LITERAL}{ONE_CHAR}{STAR}"
            ),
            "**/.*" => {
                format!("(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{DOT_LITERAL}{ON
E_CHAR}{STAR}")
            }
            // `/^(.*?)\.(\w+)$/`: recurse on the stem, append the literal 
extension.
            _ => {
                let (stem, ext) = split_extension(str)?;
                let source = fastpath_create(stem)?;
                format!("{source}{DOT_LITERAL}{ext}")
            }
        })
    }
    
    /// Applies `/^(.*?)\.(\w+)$/` to `str`; the lazy stem takes the first dot 
that
    /// leaves a word-character-only suffix.
    fn split_extension(str: &str) -> Option<(&str, &str)> {
        let is_word = |c: char| c.is_ascii_alphanumeric() || c == '_';
        str.char_indices().filter(|&(_, c)| c == '.').find_map(|(i, _)| {
            let ext = &str[i + 1..];
            (!ext.is_empty() && ext.chars().all(is_word)).then_some((&str[..i], 
ext))
        })
    }
    
    #[derive(Clone, Copy, PartialEq, Eq, Debug)]
    enum Kind {
        Bos,
        Slash,
        Dot,
        Dots,
        Text,
        Star,
        Globstar,
        Bracket,
        Paren,
        Brace,
        Comma,
        Qmark,
        Plus,
        At,
        MaybeSlash,
    }
    
    #[derive(Clone)]
    struct Token {
        kind: Kind,
        value: String,
        output: Option<String>,
        star: bool,
        posix: bool,
        extglob: bool,
        /// `brace` tokens remember where they began so `}` can rewrite the 
span.
        output_index: usize,
        tokens_index: usize,
        /// Index of the preceding token, mirroring JS's `tok.prev` links.
        prev: usize,
    }
    
    impl Token {
        fn new(kind: Kind, value: impl Into<String>) -> Self {
            Self {
                kind,
                value: value.into(),
                output: None,
                star: false,
                posix: false,
                extglob: false,
                output_index: 0,
                tokens_index: 0,
                prev: 0,
            }
        }
    
        fn with_output(kind: Kind, value: impl Into<String>, output: impl 
Into<String>) -> Self {
            let mut token = Self::new(kind, value);
            token.output = Some(output.into());
            token
        }
    
        fn rendered(&self) -> &str {
            self.output.as_deref().unwrap_or(&self.value)
        }
    }
    
    /// A pending extglob group, mirroring `EXTGLOB_CHARS` plus the bookkeeping
    /// `extglobOpen` attaches to it.
    struct Extglob {
        kind: Kind,
        close: String,
        inner: String,
        parens: usize,
        prev_kind: Kind,
    }
    
    fn extglob_chars(value: char) -> (Kind, &'static str, String) {
        match value {
            '!' => (Kind::Text, "(?:(?!(?:", format!(")){STAR})")),
            '?' => (Kind::Qmark, "(?:", ")?".to_string()),
            '+' => (Kind::Plus, "(?:", ")+".to_string()),
            '*' => (Kind::Star, "(?:", ")*".to_string()),
            _ => (Kind::At, "(?:", ")".to_string()),
        }
    }
    
    /// `utils.escapeRegex` / `REGEX_SPECIAL_CHARS_GLOBAL`
    fn is_regex_special(c: char) -> bool {
        matches!(c, '-' | '*' | '+' | '?' | '.' | '^' | '$' | '{' | '}' | '(' | 
'|' | ')' | '[' | ']')
    }
    
    fn escape_regex(text: &str) -> String {
        let mut out = String::with_capacity(text.len());
        for c in text.chars() {
            if is_regex_special(c) {
                out.push('\\');
            }
            out.push(c);
        }
        out
    }
    
    /// `REGEX_NON_SPECIAL_CHARS`: `/^[^@![\].,$*+?^{}()|\\/]+/`
    fn non_special_run(chars: &[char], from: usize) -> usize {
        let special = |c: char| {
            matches!(
                c,
                '@' | '!'
                    | '['
                    | ']'
                    | '.'
                    | ','
                    | '$'
                    | '*'
                    | '+'
                    | '?'
                    | '^'
                    | '{'
                    | '}'
                    | '('
                    | ')'
                    | '|'
                    | '\\'
                    | '/'
            )
        };
        let mut len = 0;
        while from + len < chars.len() && !special(chars[from + len]) {
            len += 1;
        }
        len
    }
    
    /// Mutable tokenizer state, standing in for `parse`'s closure variables.
    struct State {
        input: Vec<char>,
        index: isize,
        start: usize,
        output: String,
        consumed: String,
        negated: bool,
        backtrack: bool,
        brackets: usize,
        braces: usize,
        parens: usize,
        quotes: usize,
        tokens: Vec<Token>,
        /// Index into `tokens` of the token JS calls `prev`.
        prev: usize,
        stack: Vec<Kind>,
        extglobs: Vec<Extglob>,
        braces_stack: Vec<usize>,
    }
    
    impl State {
        fn eos(&self) -> bool {
            self.index == self.input.len() as isize - 1
        }
    
        fn peek_n(&self, n: isize) -> Option<char> {
            let i = self.index + n;
            if i < 0 {
                return None;
            }
            self.input.get(i as usize).copied()
        }
    
        fn peek(&self) -> Option<char> {
            self.peek_n(1)
        }
    
        fn advance(&mut self) -> char {
            self.index += 1;
            self.peek_n(0).unwrap_or('\0')
        }
    
        fn remaining(&self) -> String {
            let from = (self.index + 1).max(0) as usize;
            self.input.get(from..).map(|s| 
s.iter().collect()).unwrap_or_default()
        }
    
        fn consume(&mut self, value: &str, num: isize) {
            self.consumed.push_str(value);
            self.index += num;
        }
    
        fn prev(&self) -> &Token {
            &self.tokens[self.prev]
        }
    
        fn prev_mut(&mut self) -> &mut Token {
            let i = self.prev;
            &mut self.tokens[i]
        }
    
        /// `append`
        fn append(&mut self, token: &Token) {
            let rendered = token.rendered().to_string();
            self.output.push_str(&rendered);
            let value = token.value.clone();
            self.consume(&value, 0);
        }
    
        fn append_value(&mut self, value: &str) {
            self.output.push_str(value);
            self.consume(value, 0);
        }
    
        /// `push`
        fn push(&mut self, mut token: Token) {
            if self.prev().kind == Kind::Globstar {
                let is_brace =
                    self.braces > 0 && (token.kind == Kind::Comma || token.kind 
== Kind::Brace);
                let is_extglob = token.extglob
                    || (!self.extglobs.is_empty() && token.kind == Kind::Paren)
                    || (!self.extglobs.is_empty() && token.value == "|");
    
                if token.kind != Kind::Slash && token.kind != Kind::Paren && 
!is_brace && !is_extglob {
                    let prev_len = self.prev().rendered().len();
                    self.output.truncate(self.output.len() - prev_len);
                    let prev = self.prev_mut();
                    prev.kind = Kind::Star;
                    prev.value = "*".to_string();
                    prev.output = Some(STAR.to_string());
                    let star = STAR.to_string();
                    self.output.push_str(&star);
                }
            }
    
            if !self.extglobs.is_empty() && token.kind != Kind::Paren {
                let value = token.value.clone();
                if let Some(last) = self.extglobs.last_mut() {
                    last.inner.push_str(&value);
                }
            }
    
            if !token.value.is_empty() || token.output.is_some() {
                self.append(&token);
            }
    
            if self.prev().kind == Kind::Text && token.kind == Kind::Text {
                let value = token.value.clone();
                let prev = self.prev_mut();
                let merged = format!("{}{}", 
prev.output.clone().unwrap_or(prev.value.clone()), value);
                prev.output = Some(merged);
                prev.value.push_str(&value);
                return;
            }
    
            token.prev = self.prev;
            self.tokens.push(token);
            self.prev = self.tokens.len() - 1;
        }
    
        fn increment(&mut self, kind: Kind) {
            match kind {
                Kind::Bracket => self.brackets += 1,
                Kind::Brace => self.braces += 1,
                Kind::Paren => self.parens += 1,
                _ => {}
            }
            self.stack.push(kind);
        }
    
        fn decrement(&mut self, kind: Kind) {
            match kind {
                Kind::Bracket => self.brackets = 
self.brackets.saturating_sub(1),
                Kind::Brace => self.braces = self.braces.saturating_sub(1),
                Kind::Paren => self.parens = self.parens.saturating_sub(1),
                _ => {}
            }
            self.stack.pop();
        }
    
        /// `negate`
        fn negate(&mut self) -> bool {
            let mut count = 1;
            while self.peek() == Some('!')
                && (self.peek_n(2) != Some('(') || self.peek_n(3) == Some('?'))
            {
                self.advance();
                self.start += 1;
                count += 1;
            }
            if count % 2 == 0 {
                return false;
            }
            self.negated = true;
            self.start += 1;
            true
        }
    
        /// `extglobOpen`
        fn extglob_open(&mut self, kind: Kind, value: char) {
            let (tok_kind, open, close) = extglob_chars(value);
            let token = Extglob {
                kind: tok_kind,
                close,
                inner: String::new(),
                parens: self.parens,
                prev_kind: self.prev().kind,
            };
    
            self.increment(Kind::Paren);
            let output = if self.output.is_empty() { ONE_CHAR.to_string() } else
{ String::new() };
            self.push(Token::with_output(kind, value.to_string(), output));
    
            let next = self.advance();
            let mut paren = Token::with_output(Kind::Paren, next.to_string(), 
open);
            paren.extglob = true;
            self.push(paren);
    
            self.extglobs.push(token);
        }
    
        /// `extglobClose`
        fn extglob_close(&mut self, token: Extglob, value: &str) {
            let mut output = token.close.clone();
    
            if token.kind == Kind::Text {
                let mut extglob_star = STAR.to_string();
                if token.inner.len() > 1 && token.inner.contains('/') {
                    extglob_star = globstar();
                }
    
                let rest = self.remaining();
                if extglob_star != STAR
                    || self.eos()
                    || (!rest.is_empty() && rest.chars().all(|c| c == ')'))
                {
                    output = format!(")$)){extglob_star}");
                }
    
                if token.inner.contains('*') {
                    let rest = self.remaining();
                    // `/^\.[^\\/.]+$/`
                    let matches_ext = rest.len() > 1
                        && rest.starts_with('.')
                        && rest[1..].chars().all(|c| !matches!(c, '\\' | '/' | 
'.'));
                    if matches_ext {
                        let (expression, _) = parse_with(&rest, false);
                        output = format!("){expression}){extglob_star})");
                    }
                }
            }
    
            let mut paren = Token::with_output(Kind::Paren, value, output);
            paren.extglob = true;
            self.push(paren);
            self.decrement(Kind::Paren);
        }
    }
    
    /// `parse(input, { dot: true })`, returning the regex body and whether the
    /// pattern was negated.
    fn parse(input: &str) -> (String, bool) {
        parse_with(input, true)
    }
    
    fn parse_with(input: &str, fastpaths_enabled: bool) -> (String, bool) {
        let input = replacement(input);
    
        if fastpaths_enabled {
            if let Some(output) = inner_fastpath(input) {
                return output;
            }
        }
    
        let mut state = State {
            input: Vec::new(),
            index: -1,
            start: 0,
            output: String::new(),
            consumed: String::new(),
            negated: false,
            backtrack: false,
            brackets: 0,
            braces: 0,
            parens: 0,
            quotes: 0,
            tokens: vec![Token::new(Kind::Bos, "")],
            prev: 0,
            stack: Vec::new(),
            extglobs: Vec::new(),
            braces_stack: Vec::new(),
        };
        state.tokens[0].output = Some(String::new());
        state.input = remove_prefix(input).chars().collect();
    
        tokenize(&mut state);
        finish(&mut state);
    
        (state.output.clone(), state.negated)
    }
    
    /// The fast path inside `parse` itself, which wraps its own output (so
    /// `compileRe` wraps it a second time).
    fn inner_fastpath(input: &str) -> Option<(String, bool)> {
        // Guard: `/(^[*!]|[/()[\]{}"])/`
        let first = input.chars().next()?;
        if first == '*'
            || first == '!'
            || input.chars().any(|c| matches!(c, '/' | '(' | ')' | '[' | ']' | 
'{' | '}' | '"'))
        {
            return None;
        }
    
        let mut backslashes = false;
        let mut output = String::new();
    
        // `REGEX_SPECIAL_CHARS_BACKREF`: /(\\?)((\W)(\3*))/g
        let chars: Vec<char> = input.chars().collect();
        let mut i = 0;
        while i < chars.len() {
            let esc = chars[i] == '\\' && i + 1 < chars.len() && !chars[i + 
1].is_alphanumeric();
            let start = i;
            if esc {
                i += 1;
            }
            let c = chars[i];
            if c.is_alphanumeric() || c == '_' {
                // `\W` did not match here; copy through verbatim.
                output.push(c);
                i += 1;
                continue;
            }
            // `(\3*)`: the run of characters identical to the first.
            let mut run = 0;
            while i + 1 + run < chars.len() && chars[i + 1 + run] == c {
                run += 1;
            }
            let esc_str: String = if esc { "\\".to_string() } else { 
String::new() };
            let whole: String = chars[start..=i + run].iter().collect();
    
            match c {
                '\\' => {
                    backslashes = true;
                    output.push_str(&whole);
                }
                '?' => {
                    if esc {
                        output.push_str(&esc_str);
                        output.push(c);
                        output.push_str(&QMARK.repeat(run));
                    } else if start == 0 {
                        // `qmarkNoDot` is QMARK when `dot: true`.
                        output.push_str(QMARK);
                        output.push_str(&QMARK.repeat(run));
                    } else {
                        output.push_str(&QMARK.repeat(run + 1));
                    }
                }
                '.' => output.push_str(&DOT_LITERAL.repeat(run + 1)),
                '*' => {
                    if esc {
                        output.push_str(&esc_str);
                        output.push(c);
                        if run > 0 {
                            output.push_str(STAR);
                        }
                    } else {
                        output.push_str(STAR);
                    }
                }
                _ => {
                    if esc {
                        output.push_str(&whole);
                    } else {
                        output.push('\\');
                        output.push_str(&whole);
                    }
                }
            }
            i += run + 1;
        }
    
        if backslashes {
            // `output.replace(/\\+/g, m => m.length % 2 === 0 ? '\\\\' : '\\')`
            let mut collapsed = String::with_capacity(output.len());
            let chars: Vec<char> = output.chars().collect();
            let mut i = 0;
            while i < chars.len() {
                if chars[i] == '\\' {
                    let mut len = 0;
                    while i + len < chars.len() && chars[i + len] == '\\' {
                        len += 1;
                    }
                    collapsed.push_str(if len % 2 == 0 { "\\\\" } else { "\\" 
});
                    i += len;
                } else {
                    collapsed.push(chars[i]);
                    i += 1;
                }
            }
            output = collapsed;
        }
    
        Some((wrap_output(&output, false), false))
    }
    
    fn tokenize(state: &mut State) {
        while !state.eos() {
            let mut value = state.advance().to_string();
    
            if value == "\0" {
                continue;
            }
    
            // Escaped characters
            if value == "\\" {
                let next = state.peek();
    
                if next == Some('/') || next == Some('.') || next == Some(';') {
                    continue;
                }
    
                if next.is_none() {
                    value.push('\\');
                    state.push(Token::new(Kind::Text, value));
                    continue;
                }
    
                // collapse slashes to reduce potential for exploits
                let rest = state.remaining();
                let run = rest.chars().take_while(|&c| c == '\\').count();
                if run > 2 {
                    state.index += run as isize;
                    if run % 2 != 0 {
                        value.push('\\');
                    }
                }
    
                value.push(state.advance());
    
                if state.brackets == 0 {
                    state.push(Token::new(Kind::Text, value));
                    continue;
                }
            }
    
            // Inside a character class, consume until the closing bracket.
            if state.brackets > 0
                && (value != "]" || state.prev().value == "[" || 
state.prev().value == "[^")
            {
                if value == ":" {
                    let inner: String = 
state.prev().value.chars().skip(1).collect();
                    if inner.contains('[') {
                        state.prev_mut().posix = true;
    
                        if inner.contains(':') {
                            let prev_value = state.prev().value.clone();
                            let idx = prev_value.rfind('[').unwrap();
                            let pre = &prev_value[..idx];
                            let rest = &prev_value[idx + 2..];
                            if let Some(posix) = posix_class(rest) {
                                state.prev_mut().value = 
format!("{pre}{posix}");
                                state.backtrack = true;
                                state.advance();
    
                                let bos_empty = 
state.tokens[0].output.as_deref() == Some("");
                                if bos_empty && state.prev == 1 {
                                    state.tokens[0].output = 
Some(ONE_CHAR.to_string());
                                }
                                continue;
                            }
                        }
                    }
                }
    
                if (value == "[" && state.peek() != Some(':'))
                    || (value == "-" && state.peek() == Some(']'))
                {
                    value = format!("\\{value}");
                }
    
                if value == "]" && (state.prev().value == "[" || 
state.prev().value == "[^") {
                    value = format!("\\{value}");
                }
    
                state.prev_mut().value.push_str(&value);
                state.append_value(&value);
                continue;
            }
    
            // Inside a quoted string, consume until the closing double quote.
            if state.quotes == 1 && value != "\"" {
                let escaped = escape_regex(&value);
                state.prev_mut().value.push_str(&escaped);
                state.append_value(&escaped);
                continue;
            }
    
            if value == "\"" {
                state.quotes = if state.quotes == 1 { 0 } else { 1 };
                continue;
            }
    
            // Parentheses
            if value == "(" {
                state.increment(Kind::Paren);
                state.push(Token::new(Kind::Paren, value));
                continue;
            }
    
            if value == ")" {
                let closes_extglob = state
                    .extglobs
                    .last()
