/// The epilogue of `parse`: balance unclosed groups, add the trailing optional
/// slash, and rebuild the output if any token was rewritten.
fn finish(state: &mut State) {
    while state.brackets > 0 {
        state.output = escape_last(&state.output, '[');
        state.decrement(Kind::Bracket);
    }

    while state.parens > 0 {
        state.output = escape_last(&state.output, '(');
        state.decrement(Kind::Paren);
    }

    while state.braces > 0 {
        state.output = escape_last(&state.output, '{');
        state.decrement(Kind::Brace);
    }

    if matches!(state.prev().kind, Kind::Star | Kind::Bracket) {
        state.push(Token::with_output(Kind::MaybeSlash, "", 
format!("{SLASH_LITERAL}?")));
    }

    if state.backtrack {
        state.output = state.tokens.iter().map(|t| 
t.rendered().to_string()).collect();
    }
}

