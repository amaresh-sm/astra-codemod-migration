    use napi::bindgen_prelude::*;
    use napi::{Env, JsFunction, JsObject, JsUnknown};
    use napi_derive::napi;
    
    #[napi]
    pub fn probe(env: Env, require: JsFunction) -> Result<JsObject> {
        let recast: JsObject = require
            .call(None, &[env.create_string("recast")?])?
            .coerce_to_object()?;
        let parse: JsFunction = recast.get_named_property("parse")?;
        let ast: JsObject = parse
            .call(None, &[env.create_string("var foo = 1;")?])?
            .coerce_to_object()?;
        let types: JsObject = recast.get_named_property("types")?;
        let named_types: JsObject = types.get_named_property("namedTypes")?;
        let file: JsObject = named_types.get_named_property("File")?;
        let check: JsFunction = file.get_named_property("check")?;
        let is_file: bool = check
            .call(Some(&file), &[ast.into_unknown()])?
            .coerce_to_bool()?
            .get_value()?;
    
        let mut out = env.create_object()?;
        out.set_named_property("isFile", env.get_boolean(is_file)?)?;
    
        // Rust-defined method on a JS object
        let f = env.create_function_from_closure("rustMethod", |ctx| {
            let this: JsObject = ctx.this()?;
            let v: i32 = 
this.get_named_property::<JsUnknown>("value")?.coerce_to_number()?.get_int32()?;
            ctx.env.create_int32(v * 2)
        })?;
        out.set_named_property("value", env.create_int32(21)?)?;
        out.set_named_property("rustMethod", f)?;
        Ok(out)
    }
    

  kind: "FileEditorAction"

