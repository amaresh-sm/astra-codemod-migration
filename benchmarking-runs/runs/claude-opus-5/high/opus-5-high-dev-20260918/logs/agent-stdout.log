Summary: Add push_escape helper

Action: FileEditorAction

Arguments:
  command: "str_replace"
  path: "/workspace/codebase/rust/crates/core/src/picomatch.rs"
  old_str: "/// Rewrites a JS-valid source into an equivalent one `fancy-regex` 
accepts."
  new_str: 
    /// Emits `\c`, rewriting a JS identity escape the Rust engine would 
otherwise
    /// reinterpret into an escape that is unambiguously the literal character.
    fn push_escape(out: &mut String, c: char) {
        if shared_escape(c) {
            out.push('\\');
            out.push(c);
        } else if c.is_alphanumeric() {
            // `\a` -> `[a]`: a class is a literal for any alphanumeric, whereas
a
            // bare `a` could merge with adjacent text and `\a` means bell.
            out.push('[');
            out.push(c);
            out.push(']');
        } else {
            out.push('\\');
            out.push(c);
        }
    }
    
    /// Rewrites a JS-valid source into an equivalent one `fancy-regex` accepts.

