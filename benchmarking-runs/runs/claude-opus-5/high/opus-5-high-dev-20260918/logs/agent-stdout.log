#[test]
fn add_from_file_reads_gitignore_style_lines() {
    let dir = tempfile::tempdir().unwrap();
    let config = dir.path().join(".gitignore");
    std::fs::write(&config, "# a 
comment\nnode_modules\n\nbuild/\r\nsrc/*.min.js\n").unwrap();

    let mut ignores = IgnoreFiles::new();
    ignores.add_from_file([&config]);

    // A bare name expands to `**/node_modules` + `node_modules`, which match
    // the directory itself but not paths below it.
    assert!(ignores.should_ignore("node_modules"));
    assert!(ignores.should_ignore("a/node_modules"));
    assert!(!ignores.should_ignore("a/node_modules/x.js"));
    assert!(ignores.should_ignore("build/out.js"));
    assert!(ignores.should_ignore("a/build/out.js"));
    assert!(ignores.should_ignore("src/app.min.js"));
    assert!(!ignores.should_ignore("src/app.js"));
    // Comment lines must not become patterns.
    assert!(!ignores.should_ignore("a comment"));
}

