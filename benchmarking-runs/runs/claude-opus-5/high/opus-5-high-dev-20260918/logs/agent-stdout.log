    fn push(tokens: &mut Vec<Token>, output: &mut String, token: Token) {
        // picomatch merges adjacent literal text tokens; the rendered output is
        // unaffected, so only the emitted string is accumulated here.
        output.push_str(token.rendered());
        tokens.push(token);
    }
    
    fn is_regex_special(c: char) -> bool {
        matches!(
            c,
            '.' | '+' | '*' | '?' | '^' | '$' | '(' | ')' | '[' | ']' | '{' | 
'}' | '|' | '/' | '\\' | '#'
                | ' ' | '-' | '!' | '<' | '>' | '=' | ':' | ',' | '&' | '~' | 
'%' | '@' | '"' | '\''
                | '`' | ';'
        )
    }
    
    fn escape_regex(text: &str) -> String {
        text.chars()
            .flat_map(|c| {
                let escape = matches!(
                    c,
                    '.' | '+' | '*' | '?' | '^' | '$' | '(' | ')' | '[' | ']' | 
'{' | '}' | '|' | '/' | '\\'
                );
                escape.then_some('\\').into_iter().chain(std::iter::once(c))
            })
            .collect()
    }
    
    /// Finds the `]` closing a bracket expression opened before `from`.
    fn find_bracket_end(chars: &[char], from: usize) -> Option<usize> {
        let mut i = from;
        // A leading `!`/`^` and a first literal `]` are part of the class.
        if matches!(chars.get(i), Some('!') | Some('^')) {
            i += 1;
        }
        if chars.get(i) == Some(&']') {
            i += 1;
        }
        while i < chars.len() {
            match chars[i] {
                '\\' => i += 1,
                ']' => return Some(i),
                _ => {}
            }
            i += 1;
        }
        None
    }
    
    fn find_brace_end(chars: &[char], from: usize) -> Option<usize> {
        let mut depth = 1;
        let mut i = from;
        while i < chars.len() {
            match chars[i] {
                '\\' => i += 1,
                '{' => depth += 1,
                '}' => {
                    depth -= 1;
                    if depth == 0 {
                        return Some(i);
                    }
                }
                _ => {}
            }
            i += 1;
        }
        None
    }
    
    /// Splits a brace body on top-level commas.
    fn split_top_level(body: &str) -> Vec<String> {
        let mut parts = vec![String::new()];
        let mut depth = 0;
        let mut escaped = false;
        for c in body.chars() {
            if escaped {
                parts.last_mut().unwrap().push(c);
                escaped = false;
                continue;
            }
            match c {
                '\\' => {
                    escaped = true;
                    parts.last_mut().unwrap().push(c);
                }
                '{' | '[' | '(' => {
                    depth += 1;
                    parts.last_mut().unwrap().push(c);
                }
                '}' | ']' | ')' => {
                    depth -= 1;
                    parts.last_mut().unwrap().push(c);
                }
                ',' if depth == 0 => parts.push(String::new()),
                _ => parts.last_mut().unwrap().push(c),
            }
        }
        parts
    }
    

