  new_str: 
    fn norm(s: &str) -> String {
        let chars: Vec<char> = s.chars().collect();
        let mut out = String::with_capacity(s.len());
        let mut i = 0;
        while i < chars.len() {
            if chars[i] == '\\' && i + 1 < chars.len() {
                // Only `\/` collapses; `\\` must be preserved intact so that 
the
                // `\` in `\\/` is not mistaken for the start of an escaped 
slash.
                if chars[i + 1] == '/' {
                    out.push('/');
                } else {
                    out.push('\\');
                    out.push(chars[i + 1]);
                }
                i += 2;
            } else {
                out.push(chars[i]);
                i += 1;
            }
        }
        out
    }

