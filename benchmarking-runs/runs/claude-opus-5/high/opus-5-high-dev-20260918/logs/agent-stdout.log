+517|fn is_regex_special(c: char) -> bool {
+518|    matches!(
+519|        c,
+520|        '.' | '+' | '*' | '?' | '^' | '$' | '(' | ')' | '[' | ']' | '{' | 
'}' | '|' | '/' | '\\' | '#'
+521|            | ' ' | '-' | '!' | '<' | '>' | '=' | ':' | ',' | '&' | '~' | 
'%' | '@' | '"' | '\''
+522|            | '`' | ';'
+523|    )
+524|}
+525|
+526|fn escape_regex(text: &str) -> String {
+527|    text.chars()
+528|        .flat_map(|c| {
+529|            let escape = matches!(
+530|                c,
+531|                '.' | '+' | '*' | '?' | '^' | '$' | '(' | ')' | '[' | ']' |
'{' | '}' | '|' | '/' | '\\'
+532|            );
+533|            escape.then_some('\\').into_iter().chain(std::iter::once(c))
+534|        })
+535|        .collect()
+536|}
+537|
+538|/// Finds the `]` closing a bracket expression opened before `from`.
+539|fn find_bracket_end(chars: &[char], from: usize) -> Option<usize> {
+540|    let mut i = from;
+541|    // A leading `!`/`^` and a first literal `]` are part of the class.
+542|    if matches!(chars.get(i), Some('!') | Some('^')) {
+543|        i += 1;
+544|    }
+545|    if chars.get(i) == Some(&']') {
+546|        i += 1;
+547|    }
+548|    while i < chars.len() {
+549|        match chars[i] {
+550|            '\\' => i += 1,
+551|            ']' => return Some(i),
+552|            _ => {}
+553|        }
+554|        i += 1;
+555|    }
+556|    None
+557|}
+558|
+559|fn find_brace_end(chars: &[char], from: usize) -> Option<usize> {
+560|    let mut depth = 1;
+561|    let mut i = from;
+562|    while i < chars.len() {
+563|        match chars[i] {
+564|            '\\' => i += 1,
+565|            '{' => depth += 1,
+566|            '}' => {
+567|                depth -= 1;
+568|                if depth == 0 {
+569|                    return Some(i);
+570|                }
+571|            }
+572|            _ => {}
+573|        }
+574|        i += 1;
+575|    }
+576|    None
+577|}
+578|
+579|/// Splits a brace body on top-level commas.
+580|fn split_top_level(body: &str) -> Vec<String> {
+581|    let mut parts = vec![String::new()];
+582|    let mut depth = 0;
+583|    let mut escaped = false;
+584|    for c in body.chars() {
+585|        if escaped {
+586|            parts.last_mut().unwrap().push(c);
+587|            escaped = false;
+588|            continue;
+589|        }
+590|        match c {
+591|            '\\' => {
+592|                escaped = true;
+593|                parts.last_mut().unwrap().push(c);
+594|            }
+595|            '{' | '[' | '(' => {
+596|                depth += 1;
+597|                parts.last_mut().unwrap().push(c);
+598|            }
+599|            '}' | ']' | ')' => {
+600|                depth -= 1;
+601|                parts.last_mut().unwrap().push(c);
+602|            }
+603|            ',' if depth == 0 => parts.push(String::new()),
+604|            _ => parts.last_mut().unwrap().push(c),
+605|        }
+606|    }
+607|    parts
+608|}
