    pub struct OptionSpec {
        /// Key used in the resulting options object.
        pub key: &'static str,
        /// Long name, without the leading `--`.
        pub full: &'static str,
        /// Single character short name.
        pub abbr: Option<char>,
        /// Ordering used when rendering the help text.
        pub display_index: u32,
        /// Boolean option supporting the `--no-` prefix.
        pub flag: bool,
        /// Repeatable option collecting values into an array.
        pub list: bool,
        /// Default value, used when the option is absent.
        pub default: Option<Value>,
        /// Overrides the rendered default in the help text.
        pub default_help: Option<&'static str>,
        /// Restricts accepted values.
        pub choices: Option<&'static [&'static str]>,
        pub help: Option<&'static str>,
        pub metavar: Option<&'static str>,
        /// When set, supplying the option prints this text and exits.
        pub callback: bool,
        pub process: Process,
    }
    
    impl Default for OptionSpec {
        fn default() -> Self {
            Self {
                key: "",
                full: "",
                abbr: None,
                display_index: 0,
                flag: false,
                list: false,
                default: None,
                default_help: None,
                choices: None,
                help: None,
                metavar: None,
                callback: false,
                process: Process::None,
            }
        }
    }
    
    /// Error carrying the process exit code the CLI should terminate with.
    #[derive(Debug)]
    pub struct ParseError {
        pub exit_code: i32,
        pub message: String,
    }
    
    impl fmt::Display for ParseError {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
            write!(f, "{}", self.message)
        }
    }
    
    impl std::error::Error for ParseError {}
    
    fn throw_error(exit_code: i32, message: String, help_text: Option<&str>) -> 
ParseError {
        ParseError {
            exit_code,
            message: match help_text {
                Some(help) => format!("{message}\n\n---\n\n{help}"),
                None => message,
            },
        }
    }
    
