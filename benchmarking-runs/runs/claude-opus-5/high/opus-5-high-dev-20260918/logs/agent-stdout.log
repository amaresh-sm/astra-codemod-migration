fn to_rust_regex(source: &str) -> String {
    let chars: Vec<char> = source.chars().collect();
    let captures = capture_count(&chars);
    let mut out = String::with_capacity(source.len());
    let mut i = 0;

    while i < chars.len() {
        let empty_group = if chars[i] == '(' {
            if chars.get(i + 1) == Some(&')') {
                Some(2)
            } else if chars.get(i + 1) == Some(&'?')
                && chars.get(i + 2) == Some(&':')
                && chars.get(i + 3) == Some(&')')
            {
                Some(4)
            } else {
                None
            }
        } else {
            None
        };

        if let Some(len) = empty_group {
            out.extend(&chars[i..i + len]);
            i += len;
            // Drop any quantifier (plus a trailing lazy `?`) on the group.
            let consumed = match chars.get(i) {
                Some('*') | Some('+') | Some('?') => Some(i + 1),
                Some('{') => quantifier_brace_end(&chars, i),
                _ => None,
            };
            if let Some(end) = consumed {
                i = end;
                if chars.get(i) == Some(&'?') {
                    i += 1;
                }
            }
            continue;
        }

        match chars[i] {
            '\\' if i + 1 < chars.len() => {
                push_escape(&mut out, chars[i + 1], false, captures);
                i += 2;
            }
            '[' => {
                out.push(chars[i]);
                i += 1;
                if i < chars.len() && chars[i] == '^' {
                    out.push(chars[i]);
                    i += 1;
                }
                if i < chars.len() && chars[i] == ']' {
                    out.push(chars[i]);
                    i += 1;
                }
                while i < chars.len() && chars[i] != ']' {
                    if chars[i] == '\\' && i + 1 < chars.len() {
                        push_escape(&mut out, chars[i + 1], true, captures);
                        i += 2;
                        continue;
                    }
                    out.push(chars[i]);
                    i += 1;
                }
                if i < chars.len() {
                    out.push(chars[i]);
                    i += 1;
                }
            }
            c => {
                out.push(c);
                i += 1;
            }
        }
    }
    out
}

/// `utils.wrapOutput`
fn wrap_output(input: &str, negated: bool) -> String {
    let output = format!("^(?:{input})$");
    if negated {
        format!("(?:^(?!{output}).*$)")
    } else {
        output
    }
}

