  },
  nochange(msg, verbose) {
    verbose >= 1 && bufferedWrite(pc.bgYellow(pc.white(' NOC ')) + msg);
  },
  skip(msg, verbose) {
    verbose >= 1 && bufferedWrite(pc.bgYellow(pc.white(' SKIP ')) + msg);
  },
  error(msg, verbose) {
