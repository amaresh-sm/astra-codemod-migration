+1243|/// `/^\.[^\\/.]+$/`-adjacent helper for the `?` lookbehind check:
+1244|/// `/<([!=]|\w+>)/`
+1245|fn is_lookbehind(rest: &str) -> bool {
+1246|    let mut chars = rest.char_indices().peekable();
+1247|    while let Some((i, c)) = chars.next() {
+1248|        if c != '<' {
+1249|            continue;
+1250|        }
+1251|        let tail = &rest[i + 1..];
+1252|        if tail.starts_with('!') || tail.starts_with('=') {
+1253|            return true;
+1254|        }
+1255|        let word: String = tail.chars().take_while(|c| c.is_alphanumeric()
|| *c == '_').collect();
+1256|        if !word.is_empty() && tail[word.len()..].starts_with('>') {
+1257|            return true;
+1258|        }
+1259|    }
+1260|    false
+1261|}
