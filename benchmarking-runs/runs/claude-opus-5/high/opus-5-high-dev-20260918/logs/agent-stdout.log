//! Port of the subset of picomatch 4.0.3 that `ignoreFiles` relies on.
//!
//! `ignoreFiles` calls `picomatch.isMatch(path, patterns, { dot: true })`, so
//! this module reproduces picomatch's glob -> regex translation for the posix,
//! `dot: true` configuration and evaluates the result with `fancy_regex`
//! (needed for the lookaheads picomatch emits).
//!
//! The generated pattern source is intentionally kept identical to
//! picomatch's own output: the fixtures in `tests/fixtures/` are recorded from
//! the real implementation, and `tests/picomatch.rs` asserts the emitted regex
//! sources match it verbatim.

use fancy_regex::Regex;

const DOT_LITERAL: &str = r"\.";
const SLASH_LITERAL: &str = r"\/";
const ONE_CHAR: &str = "(?=.)";
const QMARK: &str = "[^/]";
const END_ANCHOR: &str = r"(?:\/|$)";
const START_ANCHOR: &str = r"(?:^|\/)";
const DOTS_SLASH: &str = r"\.{1,2}(?:\/|$)";
const NO_DOTS: &str = r"(?!(?:^|\/)\.{1,2}(?:\/|$))";
const NO_DOT_SLASH: &str = r"(?!\.{0,1}(?:\/|$))";
const NO_DOTS_SLASH: &str = r"(?!\.{1,2}(?:\/|$))";
const QMARK_NO_DOT: &str = r"[^.\/]";
const STAR: &str = "[^/]*?";
const MAX_LENGTH: usize = 65536;

/// `globstar({ dot: true })`
fn globstar() -> String {
    format!("(?:(?:(?!{START_ANCHOR}{DOTS_SLASH}).)*?)")
}

/// A compiled glob, mirroring one `picomatch(pattern, { dot: true })` matcher.
pub struct Matcher {
    regex: Regex,
    /// Retained so the tests can assert byte-identical regex sources.
    source: String,
}

impl Matcher {
    /// Compiles a glob. Returns `None` for inputs picomatch rejects (an empty
    /// pattern) or whose generated source cannot be compiled.
    pub fn new(pattern: &str) -> Option<Self> {
        let source = make_re(pattern)?;
        let regex = Regex::new(&source).ok()?;
        Some(Self { regex, source })
    }

    pub fn source(&self) -> &str {
        &self.source
    }

    pub fn is_match(&self, path: &str) -> bool {
        self.regex.is_match(path).unwrap_or(false)
    }
}

/// `picomatch.makeRe(input, { dot: true })`
pub fn make_re(input: &str) -> Option<String> {
    if input.is_empty() || input.len() > MAX_LENGTH {
        return None;
    }
    // `makeRe` tries `parse.fastpaths` first for patterns starting `.` or `*`.
    if input.starts_with('.') || input.starts_with('*') {
        if let Some(source) = fastpaths(input) {
            return Some(wrap_output(&source, false));
        }
    }
    let (output, negated) = parse(input);
    Some(wrap_output(&output, negated))
}

/// `utils.wrapOutput`
fn wrap_output(input: &str, negated: bool) -> String {
    let output = format!("^(?:{input})$");
    if negated {
        format!("(?:^(?!{output}).*$)")
    } else {
        output
    }
}

/// `utils.removePrefix`
fn remove_prefix(input: &str) -> &str {
    input.strip_prefix("./").unwrap_or(input)
}

/// `constants.REPLACEMENTS`
fn replacement(input: &str) -> &str {
    match input {
        "***" => "*",
        "**/**" | "**/**/**" => "**",
        other => other,
    }
}

/// `parse.fastpaths(input, { dot: true })`
fn fastpaths(input: &str) -> Option<String> {
    let input = replacement(input);
    if input.len() > MAX_LENGTH {
        return None;
    }
    let output = remove_prefix(input);
    let mut source = fastpath_create(output)?;
    source.push_str(&format!("{SLASH_LITERAL}?"));
    Some(source)
}

fn fastpath_create(str: &str) -> Option<String> {
    let globstar = globstar();
    Some(match str {
        "*" => format!("{NO_DOTS}{ONE_CHAR}{STAR}"),
        ".*" => format!("{DOT_LITERAL}{ONE_CHAR}{STAR}"),
        "*.*" => format!("{NO_DOTS}{STAR}{DOT_LITERAL}{ONE_CHAR}{STAR}"),
        "*/*" => 
format!("{NO_DOTS}{STAR}{SLASH_LITERAL}{ONE_CHAR}{NO_DOTS_SLASH}{STAR}"),
        "**" => format!("{NO_DOTS}{globstar}"),
        "**/*" => {
            format!("(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{NO_DOTS_SLASH}{ONE_
CHAR}{STAR}")
        }
        "**/*.*" => format!(
            "(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{NO_DOTS_SLASH}{STAR}{DOT_LI
TERAL}{ONE_CHAR}{STAR}"
        ),
        "**/.*" => {
            format!("(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{DOT_LITERAL}{ONE_CH
AR}{STAR}")
        }
        // `/^(.*?)\.(\w+)$/`: recurse on the stem, append the literal 
extension.
        _ => {
            let (stem, ext) = split_extension(str)?;
            let source = fastpath_create(stem)?;
            format!("{source}{DOT_LITERAL}{ext}")
        }
    })
}

/// Applies `/^(.*?)\.(\w+)$/` to `str`; the lazy stem takes the first dot that
/// leaves a word-character-only suffix.
fn split_extension(str: &str) -> Option<(&str, &str)> {
    let is_word = |c: char| c.is_ascii_alphanumeric() || c == '_';
    str.char_indices().filter(|&(_, c)| c == '.').find_map(|(i, _)| {
        let ext = &str[i + 1..];
        (!ext.is_empty() && ext.chars().all(is_word)).then(|| (&str[..i], ext))
    })
}

#[derive(Clone, Copy, PartialEq, Eq, Debug)]
enum Kind {
    Bos,
    Slash,
    Dot,
    Text,
    Star,
    Globstar,
    Bracket,
    Paren,
    Brace,
    Comma,
    Pipe,
    Qmark,
    MaybeSlash,
}

struct Token {
    kind: Kind,
    value: String,
    output: Option<String>,
    star: bool,
}

impl Token {
    fn new(kind: Kind, value: impl Into<String>, output: Option<String>) -> Self
{
        Self { kind, value: value.into(), output, star: false }
    }

    fn rendered(&self) -> &str {
        self.output.as_deref().unwrap_or(&self.value)
    }
}

