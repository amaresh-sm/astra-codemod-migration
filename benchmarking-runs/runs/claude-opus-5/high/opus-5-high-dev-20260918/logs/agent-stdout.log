+139|    let bytes = input.as_bytes();
+140|    let mut search = input.len();
+141|    while let Some(idx) = input[..search].rfind(ch) {
+142|        if idx > 0 && bytes[idx - 1] == b'\\' {
+143|            search = idx;
+144|            continue;
+145|        }
+146|        return format!("{}\\{}", &input[..idx], &input[idx..]);
+147|    }
+148|    input.to_string()
+149|}
+150|
+151|/// `constants.REPLACEMENTS`
+152|fn replacement(input: &str) -> &str {
+153|    match input {
+154|        "***" => "*",
+155|        "**/**" | "**/**/**" => "**",
+156|        other => other,
+157|    }
+158|}
+159|
+160|/// `parse.fastpaths(input, { dot: true })`
+161|fn fastpaths(input: &str) -> Option<String> {
+162|    let input = replacement(input);
+163|    if input.len() > MAX_LENGTH {
+164|        return None;
+165|    }
+166|    let output = remove_prefix(input);
+167|    let mut source = fastpath_create(output)?;
+168|    source.push_str(&format!("{SLASH_LITERAL}?"));
+169|    Some(source)
+170|}
+171|
+172|fn fastpath_create(str: &str) -> Option<String> {
+173|    let globstar = globstar();
+174|    Some(match str {
+175|        "*" => format!("{NO_DOTS}{ONE_CHAR}{STAR}"),
+176|        ".*" => format!("{DOT_LITERAL}{ONE_CHAR}{STAR}"),
+177|        "*.*" => format!("{NO_DOTS}{STAR}{DOT_LITERAL}{ONE_CHAR}{STAR}"),
+178|        "*/*" => 
format!("{NO_DOTS}{STAR}{SLASH_LITERAL}{ONE_CHAR}{NO_DOTS_SLASH}{STAR}"),
+179|        "**" => format!("{NO_DOTS}{globstar}"),
+180|        "**/*" => {
+181|            
format!("(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{NO_DOTS_SLASH}{ONE_CHAR}{STAR}"
)
+182|        }
+183|        "**/*.*" => format!(
+184|            
"(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{NO_DOTS_SLASH}{STAR}{DOT_LITERAL}{ONE_C
HAR}{STAR}"
+185|        ),
+186|        "**/.*" => {
+187|            
format!("(?:{NO_DOTS}{globstar}{SLASH_LITERAL})?{DOT_LITERAL}{ONE_CHAR}{STAR}")
+188|        }
+189|        // `/^(.*?)\.(\w+)$/`: recurse on the stem, append the literal 
extension.
+190|        _ => {
+191|            let (stem, ext) = split_extension(str)?;
+192|            let source = fastpath_create(stem)?;
+193|            format!("{source}{DOT_LITERAL}{ext}")
+194|        }
+195|    })
+196|}
+197|
+198|/// Applies `/^(.*?)\.(\w+)$/` to `str`; the lazy stem takes the first dot 
that
+199|/// leaves a word-character-only suffix.
+200|fn split_extension(str: &str) -> Option<(&str, &str)> {
+201|    let is_word = |c: char| c.is_ascii_alphanumeric() || c == '_';
+202|    str.char_indices().filter(|&(_, c)| c == '.').find_map(|(i, _)| {
+203|        let ext = &str[i + 1..];
+204|        (!ext.is_empty() && ext.chars().all(is_word)).then_some((&str[..i],
ext))
+205|    })
+206|}
+207|
+208|#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+209|enum Kind {
+210|    Bos,
+211|    Slash,
+212|    Dot,
+213|    Dots,
+214|    Text,
+215|    Star,
+216|    Globstar,
+217|    Bracket,
+218|    Paren,
+219|    Brace,
+220|    Comma,
+221|    Qmark,
+222|    Plus,
+223|    At,
+224|    MaybeSlash,
+225|}
+226|
+227|#[derive(Clone)]
+228|struct Token {
+229|    kind: Kind,
+230|    value: String,
+231|    output: Option<String>,
+232|    star: bool,
+233|    posix: bool,
+234|    extglob: bool,
+235|    /// `brace` tokens remember where they began so `}` can rewrite the 
span.
+236|    output_index: usize,
+237|    tokens_index: usize,
+238|    /// Index of the preceding token, mirroring JS's `tok.prev` links.
+239|    prev: usize,
+240|}
+241|
+242|impl Token {
+243|    fn new(kind: Kind, value: impl Into<String>) -> Self {
+244|        Self {
+245|            kind,
+246|            value: value.into(),
+247|            output: None,
+248|            star: false,
+249|            posix: false,
+250|            extglob: false,
+251|            output_index: 0,
+252|            tokens_index: 0,
+253|            prev: 0,
+254|        }
+255|    }
+256|
+257|    fn with_output(kind: Kind, value: impl Into<String>, output: impl 
Into<String>) -> Self {
+258|        let mut token = Self::new(kind, value);
+259|        token.output = Some(output.into());
+260|        token
+261|    }
+262|
+263|    fn rendered(&self) -> &str {
+264|        self.output.as_deref().unwrap_or(&self.value)
+265|    }
+266|}
+267|
+268|/// A pending extglob group, mirroring `EXTGLOB_CHARS` plus the bookkeeping
+269|/// `extglobOpen` attaches to it.
+270|struct Extglob {
+271|    kind: Kind,
+272|    close: String,
+273|    inner: String,
+274|    parens: usize,
+275|    prev_kind: Kind,
+276|}
+277|
+278|fn extglob_chars(value: char) -> (Kind, &'static str, String) {
+279|    match value {
+280|        '!' => (Kind::Text, "(?:(?!(?:", format!(")){STAR})")),
+281|        '?' => (Kind::Qmark, "(?:", ")?".to_string()),
+282|        '+' => (Kind::Plus, "(?:", ")+".to_string()),
+283|        '*' => (Kind::Star, "(?:", ")*".to_string()),
+284|        _ => (Kind::At, "(?:", ")".to_string()),
+285|    }
+286|}
+287|
+288|/// `utils.escapeRegex` / `REGEX_SPECIAL_CHARS_GLOBAL`
+289|fn is_regex_special(c: char) -> bool {
+290|    matches!(c, '-' | '*' | '+' | '?' | '.' | '^' | '$' | '{' | '}' | '(' |
'|' | ')' | '[' | ']')
+291|}
+292|
+293|fn escape_regex(text: &str) -> String {
+294|    let mut out = String::with_capacity(text.len());
+295|    for c in text.chars() {
+296|        if is_regex_special(c) {
+297|            out.push('\\');
+298|        }
+299|        out.push(c);
+300|    }
+301|    out
+302|}
+303|
+304|/// `REGEX_NON_SPECIAL_CHARS`: `/^[^@![\].,$*+?^{}()|\\/]+/`
+305|fn non_special_run(chars: &[char], from: usize) -> usize {
+306|    let special = |c: char| {
+307|        matches!(
+308|            c,
+309|            '@' | '!'
+310|                | '['
+311|                | ']'
+312|                | '.'
+313|                | ','
+314|                | '$'
+315|                | '*'
+316|                | '+'
+317|                | '?'
+318|                | '^'
+319|                | '{'
+320|                | '}'
+321|                | '('
+322|                | ')'
+323|                | '|'
+324|                | '\\'
+325|                | '/'
+326|        )
+327|    };
+328|    let mut len = 0;
+329|    while from + len < chars.len() && !special(chars[from + len]) {
+330|        len += 1;
+331|    }
+332|    len
+333|}
+334|
+335|/// Mutable tokenizer state, standing in for `parse`'s closure variables.
+336|struct State {
+337|    input: Vec<char>,
+338|    index: isize,
+339|    start: usize,
+340|    output: String,
+341|    consumed: String,
+342|    negated: bool,
+343|    backtrack: bool,
+344|    brackets: usize,
+345|    braces: usize,
+346|    parens: usize,
+347|    quotes: usize,
+348|    tokens: Vec<Token>,
+349|    /// Index into `tokens` of the token JS calls `prev`.
+350|    prev: usize,
+351|    stack: Vec<Kind>,
+352|    extglobs: Vec<Extglob>,
+353|    braces_stack: Vec<usize>,
+354|}
+355|
+356|impl State {
+357|    fn eos(&self) -> bool {
+358|        self.index == self.input.len() as isize - 1
+359|    }
+360|
+361|    fn peek_n(&self, n: isize) -> Option<char> {
+362|        let i = self.index + n;
+363|        if i < 0 {
+364|            return None;
+365|        }
+366|        self.input.get(i as usize).copied()
+367|    }
+368|
+369|    fn peek(&self) -> Option<char> {
+370|        self.peek_n(1)
+371|    }
+372|
+373|    fn advance(&mut self) -> char {
+374|        self.index += 1;
+375|        self.peek_n(0).unwrap_or('\0')
+376|    }
+377|
+378|    fn remaining(&self) -> String {
+379|        let from = (self.index + 1).max(0) as usize;
+380|        self.input.get(from..).map(|s| 
s.iter().collect()).unwrap_or_default()
+381|    }
+382|
+383|    fn consume(&mut self, value: &str, num: isize) {
+384|        self.consumed.push_str(value);
+385|        self.index += num;
+386|    }
+387|
+388|    fn prev(&self) -> &Token {
+389|        &self.tokens[self.prev]
+390|    }
+391|
+392|    fn prev_mut(&mut self) -> &mut Token {
+393|        let i = self.prev;
+394|        &mut self.tokens[i]
+395|    }
+396|
+397|    /// `append`
+398|    fn append(&mut self, token: &Token) {
+399|        let rendered = token.rendered().to_string();
+400|        self.output.push_str(&rendered);
+401|        let value = token.value.clone();
+402|        self.consume(&value, 0);
+403|    }
+404|
+405|    fn append_value(&mut self, value: &str) {
+406|        self.output.push_str(value);
+407|        self.consume(value, 0);
+408|    }
+409|
+410|    /// `push`
+411|    fn push(&mut self, mut token: Token) {
+412|        if self.prev().kind == Kind::Globstar {
+413|            let is_brace =
+414|                self.braces > 0 && (token.kind == Kind::Comma || token.kind
== Kind::Brace);
+415|            let is_extglob = token.extglob
+416|                || (!self.extglobs.is_empty() && token.kind == Kind::Paren)
+417|                || (!self.extglobs.is_empty() && token.value == "|");
+418|
+419|            if token.kind != Kind::Slash && token.kind != Kind::Paren && 
!is_brace && !is_extglob {
+420|                let prev_len = self.prev().rendered().len();
+421|                self.output.truncate(self.output.len() - prev_len);
+422|                let prev = self.prev_mut();
+423|                prev.kind = Kind::Star;
+424|                prev.value = "*".to_string();
+425|                prev.output = Some(STAR.to_string());
+426|                let star = STAR.to_string();
+427|                self.output.push_str(&star);
+428|            }
+429|        }
+430|
+431|        if !self.extglobs.is_empty() && token.kind != Kind::Paren {
+432|            let value = token.value.clone();
+433|            if let Some(last) = self.extglobs.last_mut() {
+434|                last.inner.push_str(&value);
+435|            }
+436|        }
+437|
+438|        if !token.value.is_empty() || token.output.is_some() {
+439|            self.append(&token);
+440|        }
+441|
+442|        if self.prev().kind == Kind::Text && token.kind == Kind::Text {
+443|            let value = token.value.clone();
+444|            let prev = self.prev_mut();
+445|            let merged = format!("{}{}", 
prev.output.clone().unwrap_or(prev.value.clone()), value);
+446|            prev.output = Some(merged);
+447|            prev.value.push_str(&value);
+448|            return;
+449|        }
+450|
+451|        token.prev = self.prev;
+452|        self.tokens.push(token);
+453|        self.prev = self.tokens.len() - 1;
+454|    }
+455|
+456|    fn increment(&mut self, kind: Kind) {
+457|        match kind {
+458|            Kind::Bracket => self.brackets += 1,
+459|            Kind::Brace => self.braces += 1,
+460|            Kind::Paren => self.parens += 1,
+461|            _ => {}
+462|        }
+463|        self.stack.push(kind);
+464|    }
+465|
+466|    fn decrement(&mut self, kind: Kind) {
+467|        match kind {
+468|            Kind::Bracket => self.brackets = 
self.brackets.saturating_sub(1),
+469|            Kind::Brace => self.braces = self.braces.saturating_sub(1),
+470|            Kind::Paren => self.parens = self.parens.saturating_sub(1),
+471|            _ => {}
+472|        }
+473|        self.stack.pop();
+474|    }
+475|
+476|    /// `negate`
+477|    fn negate(&mut self) -> bool {
+478|        let mut count = 1;
+479|        while self.peek() == Some('!')
+480|            && (self.peek_n(2) != Some('(') || self.peek_n(3) == Some('?'))
+481|        {
+482|            self.advance();
+483|            self.start += 1;
+484|            count += 1;
+485|        }
+486|        if count % 2 == 0 {
+487|            return false;
+488|        }
+489|        self.negated = true;
+490|        self.start += 1;
+491|        true
+492|    }
+493|
+494|    /// `extglobOpen`
+495|    fn extglob_open(&mut self, kind: Kind, value: char) {
+496|        let (tok_kind, open, close) = extglob_chars(value);
+497|        let token = Extglob {
+498|            kind: tok_kind,
+499|            close,
+500|            inner: String::new(),
+501|            parens: self.parens,
+502|            prev_kind: self.prev().kind,
+503|        };
+504|
+505|        self.increment(Kind::Paren);
+506|        let output = if self.output.is_empty() { ONE_CHAR.to_string() } 
else { String::new() };
+507|        self.push(Token::with_output(kind, value.to_string(), output));
+508|
+509|        let next = self.advance();
+510|        let mut paren = Token::with_output(Kind::Paren, next.to_string(), 
open);
+511|        paren.extglob = true;
+512|        self.push(paren);
+513|
+514|        self.extglobs.push(token);
+515|    }
+516|
+517|    /// `extglobClose`
+518|    fn extglob_close(&mut self, token: Extglob, value: &str) {
+519|        let mut output = token.close.clone();
+520|
+521|        if token.kind == Kind::Text {
+522|            let mut extglob_star = STAR.to_string();
+523|            if token.inner.len() > 1 && token.inner.contains('/') {
+524|                extglob_star = globstar();
+525|            }
+526|
+527|            let rest = self.remaining();
+528|            if extglob_star != STAR
+529|                || self.eos()
+530|                || (!rest.is_empty() && rest.chars().all(|c| c == ')'))
+531|            {
+532|                output = format!(")$)){extglob_star}");
+533|            }
+534|
+535|            if token.inner.contains('*') {
+536|                let rest = self.remaining();
+537|                // `/^\.[^\\/.]+$/`
+538|                let matches_ext = rest.len() > 1
+539|                    && rest.starts_with('.')
+540|                    && rest[1..].chars().all(|c| !matches!(c, '\\' | '/' | 
'.'));
+541|                if matches_ext {
+542|                    let (expression, _) = parse_with(&rest, false);
+543|                    output = format!("){expression}){extglob_star})");
+544|                }
+545|            }
+546|        }
+547|
+548|        let mut paren = Token::with_output(Kind::Paren, value, output);
+549|        paren.extglob = true;
+550|        self.push(paren);
+551|        self.decrement(Kind::Paren);
+552|    }
+553|}
+554|
+555|/// `parse(input, { dot: true })`, returning the regex body and whether the
+556|/// pattern was negated.
+557|fn parse(input: &str) -> (String, bool) {
+558|    parse_with(input, true)
+559|}
+560|
+561|fn parse_with(input: &str, fastpaths_enabled: bool) -> (String, bool) {
+562|    let input = replacement(input);
+563|
+564|    if fastpaths_enabled {
+565|        if let Some(output) = inner_fastpath(input) {
+566|            return output;
+567|        }
+568|    }
+569|
+570|    let mut state = State {
+571|        input: Vec::new(),
+572|        index: -1,
+573|        start: 0,
+574|        output: String::new(),
+575|        consumed: String::new(),
+576|        negated: false,
+577|        backtrack: false,
+578|        brackets: 0,
+579|        braces: 0,
+580|        parens: 0,
+581|        quotes: 0,
+582|        tokens: vec![Token::new(Kind::Bos, "")],
+583|        prev: 0,
+584|        stack: Vec::new(),
+585|        extglobs: Vec::new(),
+586|        braces_stack: Vec::new(),
+587|    };
+588|    state.tokens[0].output = Some(String::new());
+589|    state.input = remove_prefix(input).chars().collect();
+590|
+591|    tokenize(&mut state);
+592|    finish(&mut state);
+593|
+594|    (state.output.clone(), state.negated)
+595|}
+596|
+597|/// The fast path inside `parse` itself, which wraps its own output (so
+598|/// `compileRe` wraps it a second time).
+599|fn inner_fastpath(input: &str) -> Option<(String, bool)> {
+600|    // Guard: `/(^[*!]|[/()[\]{}"])/`
+601|    let first = input.chars().next()?;
+602|    if first == '*'
+603|        || first == '!'
+604|        || input.chars().any(|c| matches!(c, '/' | '(' | ')' | '[' | ']' | 
'{' | '}' | '"'))
+605|    {
+606|        return None;
+607|    }
+608|
+609|    let mut backslashes = false;
+610|    let mut output = String::new();
+611|
+612|    // `REGEX_SPECIAL_CHARS_BACKREF`: /(\\?)((\W)(\3*))/g
+613|    let chars: Vec<char> = input.chars().collect();
+614|    let mut i = 0;
+615|    while i < chars.len() {
+616|        let esc = chars[i] == '\\' && i + 1 < chars.len() && !chars[i + 
1].is_alphanumeric();
+617|        let start = i;
+618|        if esc {
+619|            i += 1;
+620|        }
+621|        let c = chars[i];
+622|        if c.is_alphanumeric() || c == '_' {
+623|            // `\W` did not match here; copy through verbatim.
+624|            output.push(c);
+625|            i += 1;
+626|            continue;
+627|        }
+628|        // `(\3*)`: the run of characters identical to the first.
+629|        let mut run = 0;
+630|        while i + 1 + run < chars.len() && chars[i + 1 + run] == c {
+631|            run += 1;
+632|        }
+633|        let esc_str: String = if esc { "\\".to_string() } else { 
String::new() };
+634|        let whole: String = chars[start..=i + run].iter().collect();
+635|
+636|        match c {
+637|            '\\' => {
+638|                backslashes = true;
+639|                output.push_str(&whole);
+640|            }
+641|            '?' => {
+642|                if esc {
+643|                    output.push_str(&esc_str);
+644|                    output.push(c);
+645|                    output.push_str(&QMARK.repeat(run));
+646|                } else if start == 0 {
+647|                    // `qmarkNoDot` is QMARK when `dot: true`.
+648|                    output.push_str(QMARK);
+649|                    output.push_str(&QMARK.repeat(run));
+650|                } else {
+651|                    output.push_str(&QMARK.repeat(run + 1));
+652|                }
+653|            }
+654|            '.' => output.push_str(&DOT_LITERAL.repeat(run + 1)),
+655|            '*' => {
+656|                if esc {
+657|                    output.push_str(&esc_str);
+658|                    output.push(c);
+659|                    if run > 0 {
+660|                        output.push_str(STAR);
+661|                    }
+662|                } else {
+663|                    output.push_str(STAR);
+664|                }
+665|            }
+666|            _ => {
+667|                if esc {
+668|                    output.push_str(&whole);
+669|                } else {
+670|                    output.push('\\');
+671|                    output.push_str(&whole);
+672|                }
+673|            }
+674|        }
+675|        i += run + 1;
+676|    }
+677|
+678|    if backslashes {
+679|        // `output.replace(/\\+/g, m => m.length % 2 === 0 ? '\\\\' : 
'\\')`
+680|        let mut collapsed = String::with_capacity(output.len());
+681|        let chars: Vec<char> = output.chars().collect();
+682|        let mut i = 0;
+683|        while i < chars.len() {
+684|            if chars[i] == '\\' {
+685|                let mut len = 0;
+686|                while i + len < chars.len() && chars[i + len] == '\\' {
+687|                    len += 1;
+688|                }
+689|                collapsed.push_str(if len % 2 == 0 { "\\\\" } else { "\\" 
});
+690|                i += len;
+691|            } else {
+692|                collapsed.push(chars[i]);
+693|                i += 1;
+694|            }
+695|        }
+696|        output = collapsed;
+697|    }
+698|
+699|    Some((wrap_output(&output, false), false))
+700|}
+701|
+702|fn tokenize(state: &mut State) {
+703|    while !state.eos() {
+704|        let mut value = state.advance().to_string();
+705|
+706|        if value == "\0" {
+707|            continue;
+708|        }
+709|
+710|        // Escaped characters
+711|        if value == "\\" {
+712|            let next = state.peek();
+713|
+714|            if next == Some('/') || next == Some('.') || next == Some(';') 
{
+715|                continue;
+716|            }
+717|
+718|            if next.is_none() {
+719|                value.push('\\');
+720|                state.push(Token::new(Kind::Text, value));
+721|                continue;
+722|            }
+723|
+724|            // collapse slashes to reduce potential for exploits
+725|            let rest = state.remaining();
+726|            let run = rest.chars().take_while(|&c| c == '\\').count();
+727|            if run > 2 {
+728|                state.index += run as isize;
+729|                if run % 2 != 0 {
+730|                    value.push('\\');
+731|                }
+732|            }
+733|
+734|            value.push(state.advance());
+735|
+736|            if state.brackets == 0 {
+737|                state.push(Token::new(Kind::Text, value));
+738|                continue;
+739|            }
+740|        }
+741|
+742|        // Inside a character class, consume until the closing bracket.
+743|        if state.brackets > 0
+744|            && (value != "]" || state.prev().value == "[" || 
state.prev().value == "[^")
+745|        {
+746|            if value == ":" {
