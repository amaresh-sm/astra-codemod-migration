+457|                    extra.push_str(ONE_CHAR);
+458|                }
+459|                if prev_kind == Some(Kind::Dot) {
+460|                    // picomatch appends to the preceding dot token's 
output.
+461|                    let dot_extra = extra.clone();
+462|                    let last = tokens.last_mut().unwrap();
+463|                    let prev_out = last.rendered().to_string();
+464|                    last.output = Some(format!("{prev_out}{dot_extra}"));
+465|                    backtrack = true;
+466|                } else {
+467|                    let prefix = extra.clone();
+468|                    token.output = Some(format!("{prefix}{STAR}"));
+469|                }
+470|            }
+471|            push(&mut tokens, &mut state_output, token);
+472|            continue;
+473|        }
