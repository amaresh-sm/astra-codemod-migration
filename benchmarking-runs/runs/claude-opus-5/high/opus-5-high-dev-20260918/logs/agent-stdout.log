    pub struct ParsedArgs {
        pub options: Map<String, Value>,
        pub positional_arguments: Vec<Value>,
    }
    
    /// Renders a JSON value the way JS string interpolation would.
    fn display_value(value: &Value) -> String {
        match value {
            Value::String(s) => s.clone(),
            Value::Array(items) => items
                .iter()
                .map(display_value)
                .collect::<Vec<_>>()
                .join(","),
            Value::Null => "null".to_string(),
            other => other.to_string(),
        }
    }
    
    fn format_option(option: &OptionSpec) -> String {
        let mut text = String::from("  ");
        match option.abbr {
            Some(abbr) => text.push_str(&format!("-{abbr}, ")),
            None => text.push_str("    "),
        }
        text.push_str(&format!(
            "--{}{}",
            if option.flag { "(no-)" } else { "" },
            option.full
        ));
        if let Some(choices) = option.choices {
            text.push_str(&format!("={}", choices.join("|")));
        } else if let Some(metavar) = option.metavar {
            text.push_str(&format!("={metavar}"));
        }
        if option.list {
            text.push_str(" ...");
        }
    
