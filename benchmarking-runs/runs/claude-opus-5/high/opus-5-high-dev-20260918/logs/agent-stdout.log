+29|    let Ok(contents) = std::fs::read_to_string(dir.join("package.json")) 
else {
+30|        return Value::Object(Default::default());
+31|    };
+32|    match serde_json::from_str::<Value>(&contents) {
+33|        // The original returns `{}` when the located manifest is not the
+34|        // package that was asked for.
+35|        Ok(pkg) if pkg.get("name").and_then(Value::as_str) == Some(name) => 
pkg,
+36|        _ => Value::Object(Default::default()),
+37|    }
+38|}
+39|
+40|/// The `version` field of a dependency's `package.json`.
+41|pub fn package_version(base_dir: &Path, name: &str) -> String {
+42|    require_package(base_dir, name)
+43|        .get("version")
+44|        .and_then(Value::as_str)
+45|        .unwrap_or("undefined")
+46|        .to_string()
