    /// One element of a character class: either a single code point (which may 
be a
    /// range endpoint) or a class escape like `\d` (which may not).
    enum ClassAtom {
        Char(u32),
        Class,
    }
    
    /// Validates the character class starting at `[` and returns the index just
    /// past its `]`, or `None` if the class is unterminated or contains an
    /// out-of-order range such as `[z-a]`.
    fn class_end(chars: &[char], start: usize) -> Option<usize> {
        let mut i = start + 1;
        if chars.get(i) == Some(&'^') {
            i += 1;
        }
        // A `]` in the first position is a literal member, not the terminator.
        if chars.get(i) == Some(&']') {
            i += 1;
        }
    
        let mut pending: Option<ClassAtom> = None;
        let mut awaiting_range = false;
    
        loop {
            match chars.get(i) {
                None => return None,
                Some(']') => return Some(i + 1),
                Some('-') if pending.is_some() && !awaiting_range => {
                    // Could start a range; a `-` just before `]` is a literal.
                    if chars.get(i + 1) == Some(&']') {
                        i += 1;
                    } else {
                        awaiting_range = true;
                        i += 1;
                    }
                }
                Some(&c) => {
                    let atom = if c == '\\' {
                        let esc = *chars.get(i + 1)?;
                        i += 2;
                        match esc {
                            'd' | 'D' | 's' | 'S' | 'w' | 'W' => 
ClassAtom::Class,
                            'n' => ClassAtom::Char('\n' as u32),
                            'r' => ClassAtom::Char('\r' as u32),
                            't' => ClassAtom::Char('\t' as u32),
                            'f' => ClassAtom::Char('\u{c}' as u32),
                            'v' => ClassAtom::Char('\u{b}' as u32),
                            'b' => ClassAtom::Char('\u{8}' as u32),
                            '0' => ClassAtom::Char(0),
                            other => ClassAtom::Char(other as u32),
                        }
                    } else {
                        i += 1;
                        ClassAtom::Char(c as u32)
                    };
    
                    if awaiting_range {
                        // A range with a class escape on either side is legal 
in
                        // Annex B (`[\d-z]`); only two chars are 
ordered-checked.
                        if let (Some(ClassAtom::Char(lo)), ClassAtom::Char(hi)) 
=
                            (pending.as_ref(), &atom)
                        {
                            if hi < lo {
                                return None;
                            }
                        }
                        awaiting_range = false;
                        pending = None;
                    } else {
                        pending = Some(atom);
                    }
                }
            }
        }
    }

