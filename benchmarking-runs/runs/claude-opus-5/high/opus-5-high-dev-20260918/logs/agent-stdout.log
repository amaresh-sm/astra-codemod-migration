'[^a]',
      '[]', '[', ']', '(', ')', '()', '|', '+', '*+', '**()', '.*', '*.*', 
'**/*',
      '\\', '\\*', '"', 'a/', '/a', '...', '(?:', '{a', 'a}', '(a', 'a)',
    ];
    
    const paths = [
      '', 'a', 'b', 'a.js', 'b.js', 'a/b', 'a/b/c', 'a/b/c.js', '.a', 'a/', 
'/a',
      'aa', 'aaa', 'ab', 'abc', 'a.b.c', 'a-b', 'a_b', 'a|b', 'a*b', '.', './a',
      '[]', '{}', 'a{}', '...', '1', '2', '3', 'a/.b', '!a',
    ];
    
    let seed = 12345;
    const rnd = (n) => {
      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
      return seed % n;
    };
    
    const patterns = new Set();
    for (const f of frag) {
      patterns.add(f);
      for (const g of frag) patterns.add(f + g);
    }
    // Random longer combinations.
    for (let i = 0; i < 60000; i++) {
      const len = 2 + rnd(4);
      let p = '';
      for (let j = 0; j < len; j++) p += frag[rnd(frag.length)];
      patterns.add(p);
    }
    
    const out = [];
    for (const pattern of patterns) {
      let source = null;
      try {
        source = picomatch.makeRe(pattern, { dot: true }).source;
      } catch (e) {
        source = null;
      }
      const matches = [];
      for (const path of paths) {
        let isMatch = null;
        try {
          isMatch = picomatch.isMatch(path, pattern, { dot: true });
        } catch (e) {
          isMatch = null;
        }
        matches.push({ path, isMatch });
      }
      out.push({ pattern, source, matches });
    }
    
    require('fs').writeFileSync('/tmp/fuzz_big.json', JSON.stringify(out));
    console.log('patterns:', out.length, 'assertions:', out.length * 
paths.length);
    

