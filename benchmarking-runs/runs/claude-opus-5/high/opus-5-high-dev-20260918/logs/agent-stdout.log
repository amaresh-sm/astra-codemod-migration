    //! Port of `utils/requirePackage.js`.
    //!
    //! Resolves a dependency's `package.json` by walking up from its entry 
point,
    //! used to report dependency versions for `--version`.
    
    use serde_json::Value;
    use std::path::{Path, PathBuf};
    
    /// Resolves `name` from `base_dir` the way `require.resolve` would, 
returning
    /// the directory of the package's own `package.json`.
    fn resolve_package_dir(base_dir: &Path, name: &str) -> Option<PathBuf> {
        let mut dir = Some(base_dir);
        while let Some(current) = dir {
            let candidate = current.join("node_modules").join(name);
            if candidate.join("package.json").is_file() {
                return Some(candidate);
            }
            dir = current.parent();
        }
        None
    }
    
    /// `requirePackage(name)`: the package's parsed `package.json`, or an empty
    /// object when it cannot be located.
    pub fn require_package(base_dir: &Path, name: &str) -> Value {
        let Some(dir) = resolve_package_dir(base_dir, name) else {
            return Value::Object(Default::default());
        };
        let Ok(contents) = std::fs::read_to_string(dir.join("package.json")) 
else {
            return Value::Object(Default::default());
        };
        match serde_json::from_str::<Value>(&contents) {
            // The original returns `{}` when the located manifest is not the
            // package that was asked for.
            Ok(pkg) if pkg.get("name").and_then(Value::as_str) == Some(name) => 
pkg,
            _ => Value::Object(Default::default()),
        }
    }
    
    /// The `version` field of a dependency's `package.json`.
    pub fn package_version(base_dir: &Path, name: &str) -> String {
        require_package(base_dir, name)
            .get("version")
            .and_then(Value::as_str)
            .unwrap_or("undefined")
            .to_string()
    }
    

  kind: "FileEditorAction"

