+510|fn push(tokens: &mut Vec<Token>, output: &mut String, token: Token) {
+511|    // picomatch merges adjacent literal text tokens; the rendered output 
is
+512|    // unaffected, so only the emitted string is accumulated here.
+513|    output.push_str(token.rendered());
+514|    tokens.push(token);
+515|}
