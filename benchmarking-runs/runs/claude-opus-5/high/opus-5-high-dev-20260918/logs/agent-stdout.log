prev.output.clone().unwrap_or(prev.value.clone()), value);
            prev.output = Some(merged);
            prev.value.push_str(&value);
            return;
        }

        token.prev = self.prev;
        self.tokens.push(token);
        self.prev = self.tokens.len() - 1;
    }

    fn increment(&mut self, kind: Kind) {
        match kind {
            Kind::Bracket => self.brackets += 1,
            Kind::Brace => self.braces += 1,
            Kind::Paren => self.parens += 1,
            _ => {}
        }
        self.stack.push(kind);
    }

    fn decrement(&mut self, kind: Kind) {
        match kind {
            Kind::Bracket => self.brackets = self.brackets.saturating_sub(1),
            Kind::Brace => self.braces = self.braces.saturating_sub(1),
            Kind::Paren => self.parens = self.parens.saturating_sub(1),
            _ => {}
        }
        self.stack.pop();
    }

