                    if i < chars.len() && chars[i] == ']' {
                        i += 1;
                    }
                    loop {
                        if i >= chars.len() {
                            return false;
                        }
                        match chars[i] {
                            '\\' => i += 2,
                            ']' => break,
                            _ => i += 1,
                        }
                    }
                    i += 1;
                    prev = Prev::Atom;
                }
                '(' => {
                    i += 1;
                    if i < chars.len() && chars[i] == '?' {
