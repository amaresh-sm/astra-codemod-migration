//! `fixtures/picomatch_oracle.json` holds, for each pattern, the regex source
//! `picomatch.makeRe(pattern, { dot: true })` produces and the outcome of
//! `picomatch.isMatch` for a corpus of paths.

use jscodeshift_core::picomatch::{make_re, Matcher};
use serde::Deserialize;

#[derive(Deserialize)]
struct PatternCase {
    pattern: String,
    source: Option<String>,
    matches: Vec<MatchCase>,
}

#[derive(Deserialize)]
struct MatchCase {
    path: String,
    #[serde(rename = "isMatch")]
    is_match: Option<bool>,
}

fn oracle() -> Vec<PatternCase> {
    serde_json::from_str(include_str!("fixtures/picomatch_oracle.json")).unwrap(
)
}

#[test]
fn generated_regex_sources_match_picomatch() {
    let cases = oracle();
    assert!(!cases.is_empty());

    let mismatches: Vec<String> = cases
        .iter()
        .filter_map(|case| {
            let actual = make_re(&case.pattern);
            (actual.as_deref() != case.source.as_deref()).then(|| {
                format!(
                    "{:?}\n  expected: {:?}\n  actual:   {:?}",
                    case.pattern, case.source, actual
                )
            })
        })
        .collect();

    assert!(
        mismatches.is_empty(),
        "{} of {} patterns compile to a different regex:\n{}",
