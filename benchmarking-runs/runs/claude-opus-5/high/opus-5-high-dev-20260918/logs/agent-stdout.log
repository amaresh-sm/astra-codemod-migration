/// leaves a word-character-only suffix.
fn split_extension(str: &str) -> Option<(&str, &str)> {
    let is_word = |c: char| c.is_ascii_alphanumeric() || c == '_';
    str.char_indices().filter(|&(_, c)| c == '.').find_map(|(i, _)| {
        let ext = &str[i + 1..];
        (!ext.is_empty() && ext.chars().all(is_word)).then_some((&str[..i], 
ext))
    })
}

#[derive(Clone, Copy, PartialEq, Eq, Debug)]
enum Kind {
    Bos,
    Slash,
    Dot,
    Dots,
    Text,
    Star,
    Globstar,
    Bracket,
    Paren,
    Brace,
    Comma,
    Qmark,
    Plus,
    At,
    MaybeSlash,
}

#[derive(Clone)]
struct Token {
    kind: Kind,
    value: String,
    output: Option<String>,
    star: bool,
    posix: bool,
    extglob: bool,
    /// `brace` tokens remember where they began so `}` can rewrite the span.
    output_index: usize,
    tokens_index: usize,
    /// Index of the preceding token, mirroring JS's `tok.prev` links.
    prev: usize,
}

impl Token {
    fn new(kind: Kind, value: impl Into<String>) -> Self {
        Self {
            kind,
            value: value.into(),
            output: None,
            star: false,
            posix: false,
            extglob: false,
            output_index: 0,
            tokens_index: 0,
            prev: 0,
        }
    }

    fn with_output(kind: Kind, value: impl Into<String>, output: impl 
Into<String>) -> Self {
        let mut token = Self::new(kind, value);
        token.output = Some(output.into());
        token
    }

    fn rendered(&self) -> &str {
        self.output.as_deref().unwrap_or(&self.value)
    }
}

