//! Ports the assertions of upstream `src/__tests__/ignoreFiles-test.js`, plus a
//! differential suite replaying results recorded from the picomatch-backed
//! implementation.

use jscodeshift_core::ignore_files::IgnoreFiles;
use serde::Deserialize;

#[derive(Deserialize)]
struct IgnoreCase {
    patterns: Vec<String>,
    path: String,
    expected: bool,
}

#[test]
fn matches_picomatch_recorded_results() {
    let cases: Vec<IgnoreCase> =
        serde_json::from_str(include_str!("fixtures/ignore_cases.json")).unwrap(
);
    assert!(!cases.is_empty());

    let mismatches: Vec<String> = cases
        .iter()
        .filter_map(|case| {
            let mut ignores = IgnoreFiles::new();
            ignores.add(&case.patterns);
            let actual = ignores.should_ignore(&case.path);
            (actual != case.expected).then(|| {
                format!(
                    "patterns={:?} path={:?}: expected {} got {}",
                    case.patterns, case.path, case.expected, actual
                )
            })
        })
        .collect();

    assert!(
        mismatches.is_empty(),
        "{} of {} cases diverge from picomatch:\n{}",
        mismatches.len(),
        cases.len(),
        mismatches.join("\n")
    );
}

