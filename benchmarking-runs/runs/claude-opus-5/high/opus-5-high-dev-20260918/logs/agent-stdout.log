    //! Verifies the picomatch port against results recorded from picomatch 
4.0.3.
    //!
    //! `fixtures/picomatch_oracle.json` holds, for each pattern, the regex 
source
    //! `picomatch.makeRe(pattern, { dot: true })` produces and the outcome of
    //! `picomatch.isMatch` for a corpus of paths.
    
    use jscodeshift_core::picomatch::{make_re, Matcher};
    use serde::Deserialize;
    
    #[derive(Deserialize)]
    struct PatternCase {
        pattern: String,
        source: Option<String>,
        matches: Vec<MatchCase>,
    }
    
    #[derive(Deserialize)]
    struct MatchCase {
        path: String,
        #[serde(rename = "isMatch")]
        is_match: Option<bool>,
    }
    
    fn oracle() -> Vec<PatternCase> {
        serde_json::from_str(include_str!("fixtures/picomatch_oracle.json")).unw
rap()
    }
    
    #[test]
    fn generated_regex_sources_match_picomatch() {
        let cases = oracle();
        assert!(!cases.is_empty());
    
        let mismatches: Vec<String> = cases
            .iter()
            .filter_map(|case| {
                let actual = make_re(&case.pattern);
                (actual.as_deref() != case.source.as_deref()).then(|| {
                    format!(
                        "{:?}\n  expected: {:?}\n  actual:   {:?}",
                        case.pattern, case.source, actual
                    )
                })
            })
            .collect();
    
        assert!(
            mismatches.is_empty(),
            "{} of {} patterns compile to a different regex:\n{}",
            mismatches.len(),
            cases.len(),
            mismatches.join("\n")
        );
    }
    
    #[test]
    fn match_results_agree_with_picomatch() {
        let cases = oracle();
        let mut checked = 0usize;
        let mut mismatches = Vec::new();
    
        for case in &cases {
            let matcher = Matcher::new(&case.pattern);
            for expectation in &case.matches {
                let Some(expected) = expectation.is_match else {
                    continue;
                };
                let actual = matcher
                    .as_ref()
                    .is_some_and(|matcher| matcher.is_match(&expectation.path));
                checked += 1;
                if actual != expected {
                    mismatches.push(format!(
                        "pattern={:?} path={:?}: expected {} got {}",
                        case.pattern, expectation.path, expected, actual
                    ));
                }
            }
        }
    
        assert!(checked > 5000, "oracle should be substantial, got {checked}");
        assert!(
            mismatches.is_empty(),
            "{} of {} assertions diverge:\n{}",
            mismatches.len(),
            checked,
            mismatches.join("\n")
        );
    }
    

  kind: "FileEditorAction"

