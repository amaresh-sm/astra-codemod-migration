use jscodeshift_core::picomatch::{make_re, Matcher};
use serde::Deserialize;

#[derive(Deserialize)]
struct PatternCase {
    pattern: String,
    source: Option<String>,
    matches: Vec<MatchCase>,
}

#[derive(Deserialize)]
struct MatchCase {
    path: String,
    #[serde(rename = "isMatch")]
    is_match: Option<bool>,
}

/// JS `RegExp.prototype.source` escapes every literal `/` so the source can be
/// round-tripped through `/.../` literal syntax. That is a serialization
/// artifact, not part of the pattern, so normalize it away before comparing.
fn norm(s: &str) -> String {
    s.replace("\\/", "/")
}

#[test]
fn fuzz_sources() {
    let cases: Vec<PatternCase> =
        serde_json::from_str(&std::fs::read_to_string("/tmp/fuzz.json").unwrap()
).unwrap();
    let mut bad = vec![];
    for case in &cases {
        let actual = make_re(&case.pattern);
        if actual.as_deref().map(norm) != case.source.as_deref().map(norm) {
            bad.push(format!(
                "{:?}\n  exp: {:?}\n  got: {:?}",
                case.pattern, case.source, actual
            ));
        }
    }
    println!("source mismatches: {} / {}", bad.len(), cases.len());
    for b in bad.iter().take(15) {
        println!("{b}");
    }
    assert!(bad.is_empty());
}

#[test]
fn fuzz_matches() {
    let cases: Vec<PatternCase> =
        serde_json::from_str(&std::fs::read_to_string("/tmp/fuzz.json").unwrap()
).unwrap();
    let mut bad = vec![];
    let mut total = 0;
    for case in &cases {
        let matcher = Matcher::new(&case.pattern);
        for m in &case.matches {
            total += 1;
            let actual = matcher.as_ref().map(|mm| mm.is_match(&m.path));
            let expected = m.is_match;
            let agree = match (expected, actual) {
                (Some(e), Some(a)) => e == a,
                (None, None) => true,
                (None, Some(a)) => !a,
                (Some(_), None) => false,
            };
            if !agree {
                bad.push(format!(
                    "pattern={:?} path={:?} exp={:?} got={:?}",
                    case.pattern, m.path, expected, actual
                ));
            }
        }
    }
    println!("match mismatches: {} / {}", bad.len(), total);
    for b in bad.iter().take(20) {
        println!("{b}");
    }
    assert!(bad.is_empty());
}

