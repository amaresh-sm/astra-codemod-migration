//! Port of `src/ignoreFiles.js`.
//!
//! Collects gitignore-style patterns and reports whether a discovered path
//! should be skipped. Patterns are compiled with `globset` configured to match
//! picomatch's `{ dot: true }` semantics (`*` stops at a separator, `**`
//! crosses them, and leading dots are matched).

use globset::{Glob, GlobMatcher};
use std::path::Path;

/// Registry of ignore matchers. The original keeps this in module state; the
/// CLI keeps a single instance for the whole run.
#[derive(Default)]
pub struct IgnoreFiles {
    matchers: Vec<GlobMatcher>,
}

fn compile(pattern: &str) -> Option<GlobMatcher> {
    Glob::new(pattern).ok().map(|glob| glob.compile_matcher())
}

impl IgnoreFiles {
    pub fn new() -> Self {
        Self::default()
    }

    pub fn is_empty(&self) -> bool {
        self.matchers.is_empty()
    }

    /// `addIgnorePattern`: expands a gitignore-style pattern into the globs
    /// picomatch is asked to match.
    fn add_ignore_pattern(&mut self, val: &str) {
        if val.is_empty() || val.starts_with('#') {
            return;
        }
        let pattern = val;
        if !pattern.contains('/') {
            self.matchers.extend(compile(&format!("**/{pattern}")));
        } else if pattern.ends_with('/') {
            self.matchers.extend(compile(&format!("**/{pattern}**")));
            self.matchers.extend(compile(&format!("{pattern}**")));
        }
        self.matchers.extend(compile(pattern));
    }

    /// `exports.add`
    pub fn add<I, S>(&mut self, patterns: I)
    where
        I: IntoIterator<Item = S>,
        S: AsRef<str>,
    {
        for pattern in patterns {
            self.add_ignore_pattern(pattern.as_ref());
        }
    }

    /// `exports.addFromFile`
    pub fn add_from_file<I, S>(&mut self, files: I)
    where
        I: IntoIterator<Item = S>,
        S: AsRef<Path>,
    {
        for file in files {
            let file = file.as_ref();
            // Matches `fs.statSync(config).isFile()`; missing files surface as
            // an error in the original, but the CLI only passes existing paths
            // for `--ignore-config` and tolerates a missing `.gitignore`.
            if !file.is_file() {
                continue;
            }
            if let Ok(content) = std::fs::read_to_string(file) {
                for line in content.split('\n') {
                    self.add_ignore_pattern(line.strip_suffix('\r').unwrap_or(li
ne));
                }
            }
        }
    }

    /// `exports.shouldIgnore`
    pub fn should_ignore(&self, path: &str) -> bool {
        if self.matchers.is_empty() {
            return false;
        }
        if self.matches(path) {
            return true;
        }
        // Paths discovered from a relative source such as `../src` keep their
        // traversal prefix, which `**` does not cross. Retry without it so the
        // result is independent of how the source path was spelled.
        // See https://github.com/facebook/jscodeshift/issues/556
        let normalized = strip_traversal_prefix(path);
        normalized != path && self.matches(normalized)
    }

    fn matches(&self, path: &str) -> bool {
        self.matchers.iter().any(|matcher| {
            matcher.is_match(path)
                // globset anchors at the start of the candidate, so an absolute
                // path is not matched by `**/...` the way picomatch matches it.
                || path
                    .strip_prefix('/')
                    .is_some_and(|relative| matcher.is_match(relative))
        })
    }
}

/// Equivalent of `path.replace(/^(?:\.\.?[/\\])+/, '')`.
fn strip_traversal_prefix(path: &str) -> &str {
    let mut rest = path;
    loop {
        let next = rest
            .strip_prefix("../")
            .or_else(|| rest.strip_prefix("..\\"))
            .or_else(|| rest.strip_prefix("./"))
            .or_else(|| rest.strip_prefix(".\\"));
        match next {
            Some(next) => rest = next,
            None => return rest,
        }
    }
}

