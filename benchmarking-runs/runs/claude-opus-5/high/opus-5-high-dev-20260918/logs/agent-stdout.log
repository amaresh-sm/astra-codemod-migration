  old_str: 
    /// Emits `\c`, rewriting a JS identity escape the Rust engine would 
otherwise
    /// reinterpret into an escape that is unambiguously the literal character.

  new_str: 
    /// Counts capturing groups, so a `\1` can be classified as a backreference 
or
    /// as the legacy octal escape JS falls back to when the group does not 
exist.
    fn capture_count(chars: &[char]) -> u32 {
        let mut count = 0;
        let mut i = 0;
        while i < chars.len() {
            match chars[i] {
                '\\' => i += 2,
                '[' => match class_end(chars, i) {
                    Some(end) => i = end,
                    None => return count,
                },
                '(' => {
                    // `(?...)` forms are non-capturing, except named 
`(?<name>`.
                    let capturing = chars.get(i + 1) != Some(&'?')
                        || (chars.get(i + 2) == Some(&'<')
                            && !matches!(chars.get(i + 3), Some('=') | 
Some('!')));
                    if capturing {
                        count += 1;
                    }
                    i += 1;
                }
                _ => i += 1,
            }
        }
        count
    }
    
