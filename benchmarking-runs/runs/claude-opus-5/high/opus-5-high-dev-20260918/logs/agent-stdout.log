Summary: Make push_escape class-aware

Thought:
Inside a character class, emitting `[a]` would produce nested brackets. Let me 
make the class case emit a bare literal instead:

Action: FileEditorAction

Arguments:
  command: "str_replace"
  path: "/workspace/codebase/rust/crates/core/src/picomatch.rs"
  old_str: 
    fn push_escape(out: &mut String, c: char) {
        if shared_escape(c) {
            out.push('\\');
            out.push(c);
        } else if c.is_alphanumeric() {
            // `\a` -> `[a]`: a class is a literal for any alphanumeric, whereas
a
            // bare `a` could merge with adjacent text and `\a` means bell.
            out.push('[');
            out.push(c);
            out.push(']');
        } else {
            out.push('\\');
            out.push(c);
        }
    }

  new_str: 
    fn push_escape(out: &mut String, c: char, in_class: bool) {
        if shared_escape(c) {
            out.push('\\');
            out.push(c);
        } else if c.is_alphanumeric() {
            // `\a` -> `[a]`, since a bare `a` could merge with an adjacent 
token.
            // Inside a class a bare literal is already unambiguous, and 
brackets
            // cannot nest there.
            if in_class {
                out.push(c);
            } else {
                out.push('[');
                out.push(c);
                out.push(']');
            }
        } else {
            out.push('\\');
            out.push(c);
        }
    }

  kind: "FileEditorAction"

