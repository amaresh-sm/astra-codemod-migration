    //! Ports the assertions of upstream `src/__tests__/argsParser-test.js`.
    
    use jscodeshift_core::args_parser::{OptionSpec, Parser, Process};
    use serde_json::{json, Map, Value};
    
    fn args(list: &[&str]) -> Vec<String> {
        list.iter().map(|s| s.to_string()).collect()
    }
    
    /// Test cases are declared as `[name, value]` pairs so each can be supplied
    /// either space separated or `=` separated, as the upstream suite does.
    fn space_separated(pairs: &[&[&str]]) -> Vec<String> {
        pairs.iter().flat_map(|pair| args(pair)).collect()
    }
    
    fn equals_separated(pairs: &[&[&str]]) -> Vec<String> {
        pairs.iter().map(|pair| pair.join("=")).collect()
    }
    
    fn no_callback(_: &OptionSpec) -> String {
        unreachable!("no callback option in this test")
    }
    
    fn parse(parser: &Parser, argv: &[String]) -> Result<(Map<String, Value>, 
Vec<Value>), String> {
        parser
            .parse(argv, &no_callback)
            .map(|parsed| (parsed.options, parsed.positional_arguments))
            .map_err(|error| error.message)
    }
    
    fn expect_options(parser: &Parser, argv: &[String], expected: Value, 
positional: Value) {
        let (options, positional_arguments) = parse(parser, argv).expect("parse 
succeeds");
        assert_eq!(Value::Object(options), expected);
        assert_eq!(Value::Array(positional_arguments), positional);
    }
    
    /// Runs a case both space separated and `=` separated.
    fn both_forms(parser: &Parser, pairs: &[&[&str]], expected: Value, 
positional: Value) {
        expect_options(parser, &space_separated(pairs), expected.clone(), 
positional.clone());
        expect_options(parser, &equals_separated(pairs), expected, positional);
    }
    
    fn both_forms_error(parser: &Parser, pairs: &[&[&str]], expected: &str) {
        for argv in [space_separated(pairs), equals_separated(pairs)] {
            let error = parse(parser, &argv).expect_err("parse fails");
            assert!(
                error.contains(expected),
                "expected error containing {expected:?}, got {error:?}"
            );
        }
    }
    
    fn option(key: &'static str) -> OptionSpec {
        OptionSpec {
            key,
            full: key,
            ..Default::default()
        }
    }
    
    #[test]
    fn prints_the_help_text() {
        let parser = Parser::new(vec![]);
        let error = parser
            .parse(&args(&["--help"]), &|_| parser.get_help_text())
            .expect_err("help aborts");
        assert_eq!(error.exit_code, 0);
        assert_eq!(error.message, parser.get_help_text());
    }
    
    #[test]
    fn parses_positional_arguments() {
        let parser = Parser::new(vec![]);
        let (_, positional) = parse(&parser, &args(&["foo", "bar"])).unwrap();
        assert_eq!(Value::Array(positional), json!(["foo", "bar"]));
    }
    
    #[test]
    fn parses_mixed_options_flags_and_positional_arguments() {
        let parser = Parser::new(vec![
            option("foo"),
            OptionSpec {
                flag: true,
                ..option("bar")
            },
            OptionSpec {
                flag: true,
                ..option("bay")
            },
            OptionSpec {
                default: Some(json!("zab")),
                ..option("baz")
            },
        ]);
        expect_options(
            &parser,
            &args(&["arg1", "--foo=1", "arg2", "--bar", "--bay=1", "arg3", 
"arg4"]),
            json!({"baz": "zab", "foo": "1", "bar": true, "bay": true}),
            json!(["arg1", "arg2", "arg3", "arg4"]),
        );
    }
    
    #[test]
    fn understands_separate_arg_name_and_short_option_names() {
        let parser = Parser::new(vec![
            OptionSpec {
                full: "another-foo",
                ..option("foo")
            },
            OptionSpec {
                abbr: Some('b'),
                ..option("bar")
            },
        ]);
        both_forms(
            &parser,
            &[&["--another-foo", "oof"], &["-b", "rab"]],
            json!({"foo": "oof", "bar": "rab"}),
            json!([]),
        );
    }
    
    #[test]
    fn understands_default_values() {
        let parser = Parser::new(vec![
            option("foo"),
            OptionSpec {
                default: Some(json!("rab")),
                ..option("bar")
            },
            OptionSpec {
                abbr: Some('b'),
                default: Some(json!("zab")),
                ..option("baz")
            },
        ]);
        both_forms(
            &parser,
            &[&["--foo", "oof"]],
            json!({"bar": "rab", "baz": "zab", "foo": "oof"}),
            json!([]),
        );
    }
    
    #[test]
    fn allows_preprocessing_values() {
        let parser = Parser::new(vec![
            option("foo"),
            OptionSpec {
                default: Some(json!(456)),
                ..option("bar")
            },
            OptionSpec {
                process: Process::Number,
                ..option("bay")
            },
        ]);
        both_forms(
            &parser,
            &[&["--foo", "123"], &["--bay", "789"]],
            json!({"bar": 456, "foo": "123", "bay": 789}),
            json!([]),
        );
    }
    
    #[test]
    fn understands_lists() {
        let parser = Parser::new(vec![
            OptionSpec {
                list: true,
                ..option("foo")
            },
            OptionSpec {
                list: true,
                ..option("bar")
            },
            option("baz"),
        ]);
        both_forms(
            &parser,
            &[
                &["--foo", "oof1"],
                &["--baz", "zab1"],
                &["--foo", "oof2"],
                &["--baz", "zab2"],
            ],
            json!({"foo": ["oof1", "oof2"], "bar": [], "baz": "zab2"}),
            json!([]),
        );
    }
    
    #[test]
    fn errors_when_an_option_does_not_have_a_value() {
        let parser = Parser::new(vec![
            option("foo"),
            OptionSpec {
                abbr: Some('b'),
                ..option("bar")
            },
            option("baz"),
        ]);
        both_forms_error(
            &parser,
            &[&["--foo", "oof"], &["-b"], &["--baz", "zab"]],
            "--bar requires a value",
        );
        both_forms_error(
            &parser,
            &[&["--foo", "oof"], &["--bar"], &["--baz", "zab"]],
            "--bar requires a value",
        );
    
        // An option with a default still errors when supplied without a value.
        let parser = Parser::new(vec![OptionSpec {
            default: Some(json!("oof")),
            ..option("foo")
        }]);
        both_forms_error(&parser, &[&["--foo"]], "--foo requires a value");
    }
    
    #[test]
    fn understands_choices() {
        let parser = Parser::new(vec![OptionSpec {
            choices: Some(&["oof"]),
            ..option("foo")
        }]);
        both_forms(
            &parser,
            &[&["--foo", "oof"]],
            json!({"foo": "oof"}),
            json!([]),
        );
    }
    
    #[test]
    fn errors_if_choice_does_not_match() {
        let parser = Parser::new(vec![
            OptionSpec {
                choices: Some(&["oof"]),
                ..option("foo")
            },
            OptionSpec {
                choices: Some(&["rab1", "rab2"]),
                ..option("bar")
            },
        ]);
        both_forms_error(
            &parser,
            &[&["--foo", "oof"], &["--bar", "rab"]],
            "--bar must be one of the values rab1,rab2",
        );
    }
    
    #[test]
    fn accepts_unknown_options() {
        let parser = Parser::new(vec![]);
        both_forms(
            &parser,
            &[
                &["--foo"],
                &["--bar"],
                &["--bay", "yab"],
                &["foo"],
                &["--b", "zab1"],
                &["--foo", "oof"],
                &["--b", "zab2"],
                &["bar"],
            ],
            json!({"foo": "oof", "bar": true, "bay": "yab", "b": ["zab1", 
"zab2"]}),
            json!(["foo", "bar"]),
        );
    }
    
    #[test]
    fn parses_unknown_options_as_json() {
        let parser = Parser::new(vec![]);
        both_forms(
            &parser,
            &[&["--foo", r#"{"foo": "bar"}"#]],
            json!({"foo": {"foo": "bar"}}),
            json!([]),
        );
    }
    
    mod flags {
        use super::*;
    
        fn parser() -> Parser {
            Parser::new(vec![
                OptionSpec {
                    abbr: Some('f'),
                    flag: true,
                    ..option("foo")
                },
                OptionSpec {
                    full: "another-bar",
                    flag: true,
                    default: Some(Value::Bool(false)),
                    ..option("bar")
                },
            ])
        }
    
        #[test]
        fn sets_values_to_true_if_specified() {
            expect_options(
                &parser(),
                &args(&["--foo", "--another-bar", "foo", "bar"]),
                json!({"bar": true, "foo": true}),
                json!(["foo", "bar"]),
            );
        }
    
        #[test]
        fn understands_short_options() {
            expect_options(
                &parser(),
                &args(&["-f", "--another-bar", "f", "bar"]),
                json!({"bar": true, "foo": true}),
                json!(["f", "bar"]),
            );
        }
    
        #[test]
        fn sets_default_value_if_not_specified() {
            expect_options(
                &parser(),
                &args(&["f", "bar"]),
                json!({"bar": false}),
                json!(["f", "bar"]),
            );
        }
    
        #[test]
        fn accepts_flag_0_and_flag_1() {
            expect_options(
                &parser(),
                &args(&["--foo=0", "--another-bar=1"]),
                json!({"bar": true, "foo": false}),
                json!([]),
            );
            expect_options(
                &parser(),
                &args(&["-f=0"]),
                json!({"bar": false, "foo": false}),
                json!([]),
            );
        }
    
        #[test]
        fn understands_no_prefixes() {
            expect_options(
                &parser(),
                &args(&["--no-foo", "--no-another-bar"]),
                json!({"bar": false, "foo": false}),
                json!([]),
            );
        }
    }
    

