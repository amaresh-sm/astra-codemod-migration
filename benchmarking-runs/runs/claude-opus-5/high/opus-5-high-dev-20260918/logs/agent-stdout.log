    /// The validity gate must model *JavaScript*, not the Rust engine, because
    /// picomatch relies on `toRegex` throwing to fall back to `/$^/`. The two
    /// engines disagree in both directions: JS rejects possessive quantifiers
    /// (`a*+`) that `fancy-regex` accepts, and accepts a quantified empty group
    /// (`(?:)*`) that `fancy-regex` rejects.
    fn js_regex_valid(source: &str) -> bool {
        let chars: Vec<char> = source.chars().collect();
        let mut i = 0;
        let mut prev = Prev::Nothing;
    
