+447|            let mut token = Token::new(Kind::Star, "*", 
Some(STAR.to_string()));
+448|            let prev_kind = tokens.last().map(|t| t.kind);
+449|            // A `*` opening a segment must not consume `.`/`..` segments.
+450|            if index - 1 == start || matches!(prev_kind, Some(Kind::Slash) 
| Some(Kind::Dot)) {
+451|                let mut extra = if prev_kind == Some(Kind::Dot) {
+452|                    NO_DOT_SLASH.to_string()
+453|                } else {
+454|                    NO_DOTS_SLASH.to_string()
+455|                };
