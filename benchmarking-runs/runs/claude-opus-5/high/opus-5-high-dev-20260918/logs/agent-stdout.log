+475|        if value == '(' {
+476|            parens += 1;
+477|            let _ = parens;
+478|            push(&mut tokens, &mut state_output, Token::new(Kind::Text, 
"(", Some(r"\(".to_string())));
+479|            continue;
+480|        }
+481|        if value == ')' {
+482|            push(&mut tokens, &mut state_output, Token::new(Kind::Text, 
")", Some(r"\)".to_string())));
+483|            continue;
+484|        }
+485|
+486|        let output = if is_regex_special(value) {
+487|            Some(format!("\\{value}"))
+488|        } else {
+489|            None
+490|        };
+491|        push(&mut tokens, &mut state_output, Token::new(Kind::Text, 
value.to_string(), output));
