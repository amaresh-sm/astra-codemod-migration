    //! Port of `src/ignoreFiles.js`.
    //!
    //! Collects gitignore-style patterns and reports whether a discovered path
    //! should be skipped. Patterns are compiled with `globset` configured to 
match
    //! picomatch's `{ dot: true }` semantics (`*` stops at a separator, `**`
    //! crosses them, and leading dots are matched).
    
    use globset::{Glob, GlobMatcher};
    use std::path::Path;
    
    /// Registry of ignore matchers. The original keeps this in module state; 
the
    /// CLI keeps a single instance for the whole run.
    #[derive(Default)]
    pub struct IgnoreFiles {
        matchers: Vec<GlobMatcher>,
    }
    
    fn compile(pattern: &str) -> Option<GlobMatcher> {
        Glob::new(pattern).ok().map(|glob| glob.compile_matcher())
    }
    
    impl IgnoreFiles {
        pub fn new() -> Self {
            Self::default()
        }
    
        pub fn is_empty(&self) -> bool {
            self.matchers.is_empty()
        }
    
        /// `addIgnorePattern`: expands a gitignore-style pattern into the globs
        /// picomatch is asked to match.
        fn add_ignore_pattern(&mut self, val: &str) {
            if val.is_empty() || val.starts_with('#') {
                return;
            }
            let pattern = val;
            if !pattern.contains('/') {
                self.matchers.extend(compile(&format!("**/{pattern}")));
            } else if pattern.ends_with('/') {
                self.matchers.extend(compile(&format!("**/{pattern}**")));
                self.matchers.extend(compile(&format!("{pattern}**")));
            }
            self.matchers.extend(compile(pattern));
        }
    
        /// `exports.add`
        pub fn add<I, S>(&mut self, patterns: I)
        where
            I: IntoIterator<Item = S>,
            S: AsRef<str>,
        {
            for pattern in patterns {
                self.add_ignore_pattern(pattern.as_ref());
            }
        }
    
        /// `exports.addFromFile`
        pub fn add_from_file<I, S>(&mut self, files: I)
        where
            I: IntoIterator<Item = S>,
            S: AsRef<Path>,
