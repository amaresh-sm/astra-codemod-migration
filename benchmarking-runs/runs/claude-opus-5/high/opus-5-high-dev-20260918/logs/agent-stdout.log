    //! Ports the assertions of upstream `src/__tests__/ignoreFiles-test.js`.
    
    use jscodeshift_core::ignore_files::IgnoreFiles;
    
    #[test]
    fn does_not_ignore_anything_when_no_patterns_were_added() {
        let ignores = IgnoreFiles::new();
        assert!(!ignores.should_ignore("src/node_modules/foo.js"));
    }
    
    mod with_a_glob_pattern {
        use super::*;
    
        fn ignores() -> IgnoreFiles {
            let mut ignores = IgnoreFiles::new();
            ignores.add(["**/node_modules/**"]);
            ignores
        }
    
        #[test]
        fn ignores_matching_plain_relative_and_absolute_paths() {
            let ignores = ignores();
            assert!(ignores.should_ignore("src/node_modules/foo.js"));
            assert!(ignores.should_ignore("/abs/src/node_modules/foo.js"));
        }
    
        #[test]
        fn ignores_matching_paths_with_a_traversal_prefix() {
            let ignores = ignores();
            assert!(ignores.should_ignore("../company.reactapp/src/node_modules/
foo.js"));
            assert!(ignores.should_ignore("./src/node_modules/foo.js"));
            assert!(ignores.should_ignore("../node_modules/foo.js"));
            assert!(ignores.should_ignore("../../a/b/node_modules/x.js"));
        }
    
        #[test]
        fn does_not_ignore_non_matching_paths_with_a_traversal_prefix() {
            let ignores = ignores();
            assert!(!ignores.should_ignore("../src/app.js"));
            assert!(!ignores.should_ignore("../src/components/Button.js"));
        }
    }
    
    #[test]
    fn bare_directory_name_pattern_ignores_regardless_of_prefix() {
        let mut ignores = IgnoreFiles::new();
        ignores.add(["node_modules"]);
        assert!(ignores.should_ignore("src/node_modules"));
        assert!(ignores.should_ignore("../company.reactapp/src/node_modules"));
        assert!(!ignores.should_ignore("../src/lib"));
    }
    
    #[test]
    fn accepts_an_array_of_patterns() {
        let mut ignores = IgnoreFiles::new();
        ignores.add(["**/node_modules/**", "**/dist/**"]);
        assert!(ignores.should_ignore("../src/node_modules/foo.js"));
        assert!(ignores.should_ignore("../src/dist/bundle.js"));
        assert!(!ignores.should_ignore("../src/index.js"));
    }
    
    #[test]
    fn add_from_file_reads_gitignore_style_lines() {
        let dir = tempfile::tempdir().unwrap();
        let config = dir.path().join(".gitignore");
        std::fs::write(&config, "# a 
comment\nnode_modules\n\nbuild/\r\nsrc/*.min.js\n").unwrap();
    
        let mut ignores = IgnoreFiles::new();
        ignores.add_from_file([&config]);
    
        assert!(ignores.should_ignore("a/node_modules/x.js"));
        assert!(ignores.should_ignore("build/out.js"));
        assert!(ignores.should_ignore("a/build/out.js"));
        assert!(ignores.should_ignore("src/app.min.js"));
        assert!(!ignores.should_ignore("src/app.js"));
        // Comment lines must not become patterns.
        assert!(!ignores.should_ignore("a comment"));
    }
    

