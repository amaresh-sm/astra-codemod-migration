  const push = tok => {
    if (prev.type === 'globstar') {
      const isBrace = state.braces > 0 && (tok.type === 'comma' || tok.type === 
'brace');
      const isExtglob = tok.extglob === true || (extglobs.length && (tok.type 
=== 'pipe' || tok.type === 'paren'));

