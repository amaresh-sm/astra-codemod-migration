# Candidate generations and verifier reports are run artifacts, not task source.
runs/
candidates/
benchmarking-candidates/

# Retain exported benchmark metadata/evidence while keeping live run artifacts ignored.
!benchmarking-runs/
!benchmarking-runs/runs/
!benchmarking-runs/runs/**

dist/
target/

# Generated Python bytecode and test caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Dependency and verifier-run artifacts.
node_modules/
verifier/proof-of-work/mutant-runs/
verifier/proof-of-work/reference-runs/
