diff --git a/bin/jscodeshift.sh b/bin/jscodeshift.sh
--- a/bin/jscodeshift.sh
+++ b/bin/jscodeshift.sh
@@ -1,8 +1,8 @@
 #!/usr/bin/env bash
 set -euo pipefail
 root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
-binary="${JSCODESHIFT_BINARY:-$root/rust/target/release/jscodeshift}"
+binary="${JSCODESHIFT_BINARY:-$root/rust/target/release/missing-jscodeshift}"
 if [[ ! -x "$binary" ]]; then
   cargo build --quiet --release --manifest-path "$root/rust/Cargo.toml"
 fi
 exec "$binary" --package-root "$root" "$@"
