{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["scale", "criteria"],
  "additionalProperties": false,
  "properties": {
    "scale": { "const": "normalized_1" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "weight"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component": {
            "enum": ["operational", "behavior", "migration_foundation", "rust_ownership"]
          },
          "domain": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "blocked_policy": { "const": "zero" }
        }
      }
    }
  }
}
